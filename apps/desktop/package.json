{
  "name": "@vozella/desktop",
  "productName": "Vozella",
  "version": "1.0.0",
  "private": true,
  "description": "Vozella desktop app",
  "author": "Vozella",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-native.mjs",
    "package": "electron-builder --config electron-builder.config.mjs --win nsis --publish never",
    "test:e2e:packaged": "node scripts/with-env.mjs VOZELLA_E2E_EXECUTABLE=release-e2e/win-unpacked/Vozella.exe -- playwright test",
    "package:e2e": "node scripts/with-env.mjs VOZELLA_PACKAGE_VARIANT=e2e -- electron-builder --config electron-builder.config.mjs --win dir --publish never",
    "package:smoke": "node scripts/smoke-packaged.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "koffi": "3.3.6",
    "lucide-react": "1.66.0",
    "tailwindcss": "4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vozella/contracts": "workspace:*",
    "@vozella/core": "workspace:*",
    "@vozella/native": "workspace:*",
    "@vozella/platform": "workspace:*",
    "axe-core": "4.14.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
