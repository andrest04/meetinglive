{
  "name": "@vozella/desktop",
  "productName": "Vozella",
  "version": "0.0.0",
  "private": true,
  "description": "Vozella desktop app",
  "author": "Vozella",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-native.mjs",
    "package": "node scripts/package.mjs",
    "package:smoke": "node scripts/smoke-packaged.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "koffi": "3.3.6"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vozella/contracts": "workspace:*",
    "@vozella/core": "workspace:*",
    "@vozella/native": "workspace:*",
    "@vozella/platform": "workspace:*",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
