    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingLive.Core\MeetingLive.Core.csproj" />
  </ItemGroup>

