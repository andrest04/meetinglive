{
  "name": "@vozella/native",
  "version": "0.1.0",
  "private": true,
  "description": "Rust N-API addon: audio capture, calendar probe, DPAPI",
  "napi": {
    "binaryName": "vozella-native",
    "targets": [
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --no-js --dts index.d.ts",
    "build:debug": "napi build --platform --no-js --dts index.d.ts",
    "typecheck": "cargo check --locked",
    "lint": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "test": "cargo test --locked"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.10"
  }
}
