<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MeetingLive_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="NavView"
                     PaneDisplayMode="Auto"
                     IsBackButtonVisible="Collapsed"
                     IsSettingsVisible="True"
                     ItemInvoked="NavView_ItemInvoked"
                     SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Uid="Nav_Record" Icon="Microphone" Tag="Recording"
                                 AutomationProperties.AutomationId="NavItemRecording" />
            <NavigationViewItem x:Uid="Nav_History" Icon="Folder" Tag="History"
                                 AutomationProperties.AutomationId="NavItemHistory" />
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
