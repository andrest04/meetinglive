<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MeetingLive_App"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    xmlns:icons="using:MeetingLive_App.Controls"
    xmlns:md="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="CallPromptBar"
                 Grid.Row="0"
                 IsClosable="True"
                 Severity="Informational"
                 Title="{x:Bind local:MainPage.CallPromptTitle()}"
                 Message="{x:Bind local:MainPage.CallPromptBody()}"
                 AutomationProperties.AutomationId="InfoCallPrompt">
            <InfoBar.ActionButton>
                <Button Click="CallPromptTakeNotes_Click"
                        Content="{x:Bind local:MainPage.CallPromptTakeNotes()}"
                        AutomationProperties.AutomationId="BtnCallPromptTakeNotes" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView x:Name="NavView"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="True"
                         DisplayModeChanged="NavView_DisplayModeChanged"
                         PaneOpened="NavView_PaneOpened"
                         PaneClosed="NavView_PaneClosed"
                         ItemInvoked="NavView_ItemInvoked"
                         SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Record" Icon="Microphone" Tag="Recording"
                                     AutomationProperties.AutomationId="NavItemRecording" />
                <NavigationViewItem x:Uid="Nav_History" Icon="Folder" Tag="History"
                                     AutomationProperties.AutomationId="NavItemHistory" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame" />

                <Expander x:Name="BarMeetingChat"
                          Grid.Row="1"
                          x:Uid="Chat_Bar"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          ExpandDirection="Up"
                          IsExpanded="{x:Bind Chat.IsExpanded, Mode=TwoWay}"
                          Visibility="{x:Bind local:MainPage.BoolToVisibility(Chat.IsVisible), Mode=OneWay}"
                          AutomationProperties.AutomationId="BarMeetingChat">
                    <Expander.Header>
                        <Grid MinWidth="240" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Padding="10,4"
                                    CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Chat.ScopeGlyph, Mode=OneWay}"
                                              FontSize="14"
                                              VerticalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Name="LblMeetingChatScope"
                                               Grid.Column="1"
                                               Text="{x:Bind Chat.ScopeLabel, Mode=OneWay}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="LblMeetingChatScope" />
                                </Grid>
                            </Border>
                            <Button x:Name="BtnMeetingChatHistory"
                                    Grid.Column="1"
                                    x:Uid="Chat_History"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    AutomationProperties.AutomationId="BtnMeetingChatHistory">
                                <FontIcon Glyph="&#xE81C;" FontSize="16" />
                                <Button.Flyout>
                                    <Flyout x:Name="ChatHistoryFlyout"
                                            Placement="TopEdgeAlignedRight"
                                            Opening="ChatHistoryFlyout_Opening">
                                        <Grid Width="320" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Uid="Chat_HistoryEmpty"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind local:MainPage.BoolToVisibility(Chat.IsHistoryEmpty), Mode=OneWay}" />
                                            <ListView Grid.Row="1"
                                                      MaxHeight="280"
                                                      SelectionMode="None"
                                                      IsItemClickEnabled="True"
                                                      ItemsSource="{x:Bind Chat.Threads, Mode=OneWay}"
                                                      ItemClick="ChatThread_ItemClick"
                                                      AutomationProperties.AutomationId="ListMeetingChatHistory">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ChatThreadItem">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind UpdatedLabel, Mode=OneTime}"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    x:Uid="Chat_DeleteThread"
                                                                    Click="DeleteChatThread_Click"
                                                                    Tag="{x:Bind Id}"
                                                                    VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="BtnMeetingChatNew"
                                    Grid.Column="2"
                                    x:Uid="Chat_New"
                                    Command="{x:Bind Chat.NewChatCommand}"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    AutomationProperties.AutomationId="BtnMeetingChatNew">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                            </Button>
                        </Grid>
                    </Expander.Header>
                    <Grid RowSpacing="8" Padding="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="ChatTranscript"
                                  x:Uid="Chat_Transcript"
                                  MaxHeight="420"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ItemsSource="{x:Bind Chat.Messages, Mode=OneWay}"
                                  Visibility="{x:Bind local:MainPage.BoolToVisibility(Chat.HasMessages), Mode=OneWay}"
                                  AutomationProperties.AutomationId="ListMeetingChat">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatMessageItem">
                                    <Grid Padding="0,6">
                                        <Grid Visibility="{x:Bind local:MainPage.BoolToVisibility(IsUser), Mode=OneTime}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Padding="12,8"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{x:Bind Text, Mode=OneTime}"
                                                           TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <Grid ColumnSpacing="8"
                                              Visibility="{x:Bind local:MainPage.BoolToVisibility(IsAssistant), Mode=OneTime}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind RoleLabel, Mode=OneTime}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <md:MarkdownTextBlock Text="{x:Bind Text, Mode=OneTime}"
                                                                      TextWrapping="WrapWholeWords"
                                                                      Background="Transparent"
                                                                      Visibility="{x:Bind local:MainPage.BoolToVisibility(HasAnswer), Mode=OneTime}" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8"
                                                            Visibility="{x:Bind local:MainPage.BoolToVisibility(IsPending), Mode=OneTime}">
                                                    <ProgressRing Width="16"
                                                                  Height="16"
                                                                  IsActive="{x:Bind IsPending, Mode=OneTime}"
                                                                  IsTabStop="False" />
                                                    <TextBlock x:Uid="Chat_Thinking"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    x:Uid="Chat_Copy"
                                                    Click="CopyChatMessage_Click"
                                                    Tag="{x:Bind}"
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Visibility="{x:Bind local:MainPage.BoolToVisibility(HasAnswer), Mode=OneTime}">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <InfoBar Grid.Row="1"
                                 x:Uid="Chat_Error"
                                 IsClosable="True"
                                 IsOpen="{x:Bind Chat.IsErrorOpen, Mode=TwoWay}"
                                 Message="{x:Bind Chat.ErrorMessage, Mode=OneWay}"
                                 Severity="Error"
                                 AutomationProperties.AutomationId="InfoMeetingChatError" />

                        <TextBlock Grid.Row="2"
                                   x:Uid="Chat_ScopeMismatch"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind local:MainPage.BoolToVisibility(Chat.ShowScopeMismatch), Mode=OneWay}" />

                        <ItemsControl Grid.Row="3"
                                      x:Uid="Chat_Starters"
                                      ItemsSource="{x:Bind Chat.StarterRecipes, Mode=OneWay}"
                                      Visibility="{x:Bind local:MainPage.BoolToVisibility(Chat.ShowStarterRecipes), Mode=OneWay}"
                                      AutomationProperties.AutomationId="ListMeetingChatStarters">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <md:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatRecipeItem">
                                    <Button Content="{x:Bind Name, Mode=OneTime}"
                                            Tag="{x:Bind}"
                                            Click="ChatStarter_Click"
                                            ToolTipService.ToolTip="{x:Bind Prompt, Mode=OneTime}"
                                            AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                            Padding="12,4"
                                            CornerRadius="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtMeetingChat"
                                     x:Uid="Chat_Composer"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxHeight="96"
                                     MinHeight="32"
                                     MinWidth="180"
                                     VerticalAlignment="Center"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Text="{x:Bind Chat.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="TxtMeetingChat_PreviewKeyDown"
                                     TextChanged="TxtMeetingChat_TextChanged"
                                     AutomationProperties.AutomationId="TxtMeetingChat" />
                            <Button x:Name="BtnMeetingChatSend"
                                    Grid.Column="1"
                                    x:Uid="Chat_Send"
                                    Command="{x:Bind Chat.SendCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="BtnMeetingChatSend">
                                <FontIcon Glyph="&#xE724;" FontSize="16" />
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator x:Name="ChatSendAccelerator"
                                                         Modifiers="Control"
                                                         Key="Enter"
                                                         Invoked="ChatSendAccelerator_Invoked" />
                                </Button.KeyboardAccelerators>
                            </Button>
                            <Button x:Name="BtnMeetingChatPersonalTasks"
                                    Grid.Column="2"
                                    x:Uid="Chat_PersonalTasks"
                                    VerticalAlignment="Bottom"
                                    Click="MeetingChatPersonalTasks_Click"
                                    Visibility="{x:Bind local:MainPage.BoolToVisibility(Chat.ShowPersonalTasksRecipe), Mode=OneWay}"
                                    AutomationProperties.AutomationId="BtnMeetingChatPersonalTasks">
                                <icons:TypeSafeIcon Width="16" Height="16" />
                            </Button>
                            <Button x:Name="BtnMeetingChatRecipes"
                                    Grid.Column="3"
                                    x:Uid="Chat_Recipes"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="BtnMeetingChatRecipes">
                                <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                                <Button.Flyout>
                                    <Flyout x:Name="ChatRecipeFlyout"
                                            Placement="TopEdgeAlignedRight"
                                            Opening="ChatRecipeFlyout_Opening">
                                        <Grid Width="320" RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Uid="Chat_NoRecipes"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind local:MainPage.InvertBoolToVisibility(Chat.HasRecipeSuggestions), Mode=OneWay}" />
                                            <ListView Grid.Row="1"
                                                      MaxHeight="240"
                                                      SelectionMode="None"
                                                      IsItemClickEnabled="True"
                                                      ItemsSource="{x:Bind Chat.RecipeSuggestions, Mode=OneWay}"
                                                      ItemClick="ChatRecipe_ItemClick"
                                                      AutomationProperties.AutomationId="ListMeetingChatRecipes">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ChatRecipeItem">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{x:Bind Name, Mode=OneTime}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Prompt, Mode=OneTime}"
                                                                           MaxLines="2"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="Wrap"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    x:Uid="Chat_DeleteRecipe"
                                                                    Click="DeleteChatRecipe_Click"
                                                                    Tag="{x:Bind Id}"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{x:Bind local:MainPage.BoolToVisibility(CanDelete), Mode=OneTime}">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Button Grid.Row="2"
                                                    x:Uid="Chat_CreateRecipe"
                                                    HorizontalAlignment="Stretch"
                                                    Click="CreateChatRecipe_Click" />
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Grid>
                </Expander>
            </Grid>
        </NavigationView>

        <local:PaneResizeGrip x:Name="PaneGrip"
                              Grid.Row="1"
                              Width="8"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              AutomationProperties.AutomationId="SizerNavigationPane"
                              PointerPressed="PaneGrip_PointerPressed"
                              PointerMoved="PaneGrip_PointerMoved"
                              PointerReleased="PaneGrip_PointerReleased"
                              PointerCaptureLost="PaneGrip_PointerReleased" />
    </Grid>
</Page>
