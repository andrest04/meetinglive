<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MeetingLive_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="NavView"
                     PaneDisplayMode="Auto"
                     IsBackButtonVisible="Collapsed"
                     IsSettingsVisible="True"
                     SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Icon="Microphone" Content="Record" Tag="Recording"
                                 AutomationProperties.AutomationId="NavItemRecording" />
            <NavigationViewItem Icon="Document" Content="Transcript" Tag="Transcript"
                                 AutomationProperties.AutomationId="NavItemTranscript" />
            <NavigationViewItem Icon="List" Content="Summary" Tag="Summary"
                                 AutomationProperties.AutomationId="NavItemSummary" />
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
