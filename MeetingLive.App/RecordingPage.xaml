<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    xmlns:models="using:MeetingLive.Core.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Storyboard x:Name="RecordingPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecordingPulse"
                             Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.45"
                             Duration="0:0:1.2" />
        </Storyboard>
    </Page.Resources>

    <!-- Row 0 is a plain Auto header (no inner ScrollViewer: an Auto row measures it with infinite height, so it would never scroll
         and would starve the * row of space). While recording the header shrinks to a compact bar and row 1 keeps the rest.
         The page-level ScrollViewer only scrolls while idle, so a short window can reach everything under the idle column. During a
         session its scroll bar is Disabled, which constrains the Grid to the viewport so the * row still fills the window. -->
    <ScrollViewer VerticalScrollBarVisibility="{x:Bind local:RecordingPage.IdleScrollBarVisibility(ViewModel.IsSessionActive), Mode=OneWay}"
                  VerticalScrollMode="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- AdaptiveTrigger measures the window, not the page. The nav pane expands at 1008 and takes ~280+, so the side-by-side layout
             starts at 1100 to keep the transcript wide enough; below that everything stacks. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidePanel.(Grid.Row)" Value="0" />
                        <Setter Target="SidePanel.(Grid.Column)" Value="1" />
                        <Setter Target="SidePanel.Width" Value="320" />
                        <Setter Target="SidePanel.Margin" Value="16,0,0,0" />
                        <Setter Target="SidePanelFirstRow.Height" Value="*" />
                        <Setter Target="SessionNotesPanel.(Grid.Row)" Value="0" />
                        <Setter Target="LiveAnswerHost.(Grid.Row)" Value="1" />
                        <Setter Target="LiveAnswerHost.Margin" Value="0,8,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TxtRecordingNotes.MaxHeight" Value="200" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Grid.Row="0" Spacing="0">

        <!-- Idle-only content. One centered column, capped so wide windows do not stretch the pickers edge to edge.
             Spacing follows the 8/16/24 scale: 24 between groups, 12 inside the title and pickers group.
             Hierarchy: title and destination, the always-visible Sources card, the Record action row, then the quiet Coming up strip. -->
        <StackPanel Spacing="24"
                    MaxWidth="960"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind local:RecordingPage.InvertBoolToVisibility(ViewModel.IsSessionActive), Mode=OneWay}">

        <StackPanel Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock x:Uid="RecordPage_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="RecordPage_Subtitle"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Uid="RecordPage_MeetingTitle"
                     Text="{x:Bind ViewModel.MeetingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{x:Bind local:RecordingPage.Not(ViewModel.IsRecording), Mode=OneWay}"
                     HorizontalAlignment="Stretch"
                     AutomationProperties.AutomationId="TxtMeetingTitle" />
            <ComboBox Grid.Column="1" x:Uid="RecordPage_Destination"
                      ItemsSource="{x:Bind ViewModel.Destinations, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDestination, Mode=OneWay}"
                      SelectionChanged="DestinationComboBox_SelectionChanged"
                      IsEnabled="{x:Bind local:RecordingPage.Not(ViewModel.IsRecording), Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="ComboRecordDestination">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderDestination">
                        <TextBlock Text="{x:Bind Path}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="260"
                                   ToolTipService.ToolTip="{x:Bind Path}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        </StackPanel>

        <StackPanel Spacing="8"
                    Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowMeetingBrief), Mode=OneWay}"
                    AutomationProperties.AutomationId="BriefSection">
            <TextBlock x:Uid="RecordPage_BriefHeading"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Uid="RecordPage_BriefText"
                       Text="{x:Bind ViewModel.MeetingBrief, Mode=OneWay}"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"
                       AutomationProperties.AutomationId="TxtMeetingBrief" />
        </StackPanel>
        <InfoBar x:Uid="RecordPage_BriefFailed"
                 IsOpen="{x:Bind ViewModel.HasBriefError, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Error"
                 Message="{x:Bind ViewModel.BriefError, Mode=OneWay}"
                 AutomationProperties.AutomationId="InfoBriefError" />

        <!-- Sources: always visible directly above Record, no Expander. Mic ComboBox is full width with a visible label so names never
             truncate; the dB-scaled meter sits right under it. Meeting audio is a wrapping list of cards (single selection): the fixed
             "All system audio" card, then one card per app that is playing. While recording this whole card is hidden with the idle column
             and the recording bar shows a one-line summary instead. -->
        <Border Style="{StaticResource CardSurface}" Padding="16">
            <StackPanel Spacing="16">
                <TextBlock x:Uid="RecordPage_SourcesHeading"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <StackPanel Spacing="8">
                    <ComboBox x:Uid="ComboRecordMicrophone"
                              ItemsSource="{x:Bind ViewModel.RecordingMicrophones, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedRecordingMicrophone, Mode=OneWay}"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="RecordMicrophoneComboBox_SelectionChanged"
                              DropDownOpened="RecordMicrophoneComboBox_DropDownOpened"
                              IsEnabled="{x:Bind local:RecordingPage.Not(ViewModel.IsRecording), Mode=OneWay}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="ComboRecordMicrophone" />
                    <ProgressBar x:Uid="RecordPage_MicLevelBar"
                                 Value="{x:Bind ViewModel.MicLevel, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 IsHitTestVisible="False"
                                 Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowMicPreview), Mode=OneWay}"
                                 AutomationProperties.AccessibilityView="Raw"
                                 AutomationProperties.AutomationId="ProgressSourcesMicrophoneLevel" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Uid="RecordPage_MeetingAudioHeading"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <GridView x:Name="AudioSourceList"
                              x:Uid="ListRecordAudioSource"
                              ItemsSource="{x:Bind ViewModel.AudioSources.Cards, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.AudioSources.SelectedCard, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="False"
                              SelectionChanged="AudioSourceList_SelectionChanged"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="ListRecordAudioSource">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AudioSourceCard">
                                <Grid Width="176"
                                      MinHeight="76"
                                      Padding="12"
                                      RowSpacing="8"
                                      Opacity="{x:Bind CardOpacity, Mode=OneWay}"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      CornerRadius="{ThemeResource ControlCornerRadius}"
                                      ToolTipService.ToolTip="{x:Bind Tooltip}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="24" Height="24" VerticalAlignment="Center"
                                              AutomationProperties.AccessibilityView="Raw">
                                            <Image Source="{x:Bind Icon, Mode=OneWay}"
                                                   Width="24" Height="24"
                                                   Visibility="{x:Bind local:RecordingPage.BoolToVisibility(HasIcon), Mode=OneWay}" />
                                            <FontIcon Glyph="{x:Bind FallbackGlyph}"
                                                      FontSize="20"
                                                      Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ShowFallbackGlyph), Mode=OneWay}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Name}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar Grid.Row="1"
                                                 Value="{x:Bind Level, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"
                                                 IsHitTestVisible="False"
                                                 Visibility="{x:Bind local:RecordingPage.BoolToVisibility(HasMeter)}"
                                                 AutomationProperties.AccessibilityView="Raw" />
                                    <StackPanel Grid.Row="2" Spacing="4"
                                                Visibility="{x:Bind local:RecordingPage.AnyVisible(ShowDetectedTag, ShowBrowserHint, ShowNotPlaying), Mode=OneWay}">
                                        <TextBlock x:Uid="RecordPage_AppDetectedTag"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ShowDetectedTag), Mode=OneWay}" />
                                        <TextBlock x:Uid="RecordPage_BrowserHint"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ShowBrowserHint), Mode=OneWay}" />
                                        <TextBlock x:Uid="RecordPage_AppNotPlaying"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ShowNotPlaying), Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock x:Uid="RecordPage_NoAppsPlaying"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.AudioSources.ShowEmptyHint), Mode=OneWay}"
                               AutomationProperties.AutomationId="TxtNoAppsPlaying" />
                    <!-- Suggestion only: it never switches the source on its own, and closing it hides it for that process. -->
                    <InfoBar x:Uid="RecordPage_MeetingAppSuggestion"
                             IsOpen="{x:Bind ViewModel.AudioSources.IsSuggestionOpen, Mode=TwoWay}"
                             IsClosable="True"
                             Severity="Informational"
                             Title="{x:Bind ViewModel.AudioSources.SuggestionTitle, Mode=OneWay}"
                             AutomationProperties.AutomationId="InfoMeetingAppSuggestion">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind ViewModel.AudioSources.SuggestionActionLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.AudioSources.UseSuggestedAppCommand}"
                                    AutomationProperties.AutomationId="BtnUseSuggestedApp" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Action area: either the setup checklist or the Record hero. Record is the only accent control on the page.
             The setup checklist has no outer card: the SettingsCards are already surfaces, so a wrapper would be card-in-card. -->
        <Grid>
            <StackPanel MaxWidth="960"
                        Spacing="12"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowSetupPanel), Mode=OneWay}">
                <TextBlock x:Uid="RecordingSetup_Headline"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <controls:SettingsCard x:Uid="RecordingSetup_Live"
                                       Description="{x:Bind ViewModel.LiveSetupDetailText, Mode=OneWay}"
                                       IsClickEnabled="False">
                    <TextBlock Text="{x:Bind ViewModel.LiveSetupStatusText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="TxtRecordLiveSetupStatus" />
                </controls:SettingsCard>
                <controls:SettingsCard x:Uid="RecordingSetup_Engine"
                                       Description="{x:Bind ViewModel.EngineSetupDetailText, Mode=OneWay}"
                                       IsClickEnabled="False">
                    <TextBlock Text="{x:Bind ViewModel.EngineSetupStatusText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="TxtRecordEngineSetupStatus" />
                </controls:SettingsCard>
                <controls:SettingsCard x:Uid="RecordingSetup_Summary"
                                       Description="{x:Bind ViewModel.SummarySetupDetailText, Mode=OneWay}"
                                       IsClickEnabled="False">
                    <TextBlock Text="{x:Bind ViewModel.SummarySetupStatusText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="TxtRecordSummarySetupStatus" />
                </controls:SettingsCard>
                <Button x:Uid="RecordingSetup_SetUpToRecord"
                        Command="{x:Bind ViewModel.SetUpToRecordCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="BtnSetUpToRecord" />
            </StackPanel>

            <StackPanel Spacing="12" HorizontalAlignment="Center"
                        Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowRecordHero), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="200"
                            MinHeight="48"
                            Padding="32,12"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="BtnToggleRecording"
                            AutomationProperties.Name="{x:Bind local:RecordingPage.RecordLabel(ViewModel.IsRecording), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind local:RecordingPage.RecordGlyph(ViewModel.IsRecording), Mode=OneWay}" FontSize="20" />
                            <TextBlock Text="{x:Bind local:RecordingPage.RecordLabel(ViewModel.IsRecording), Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control"
                                                 Key="R"
                                                 Invoked="ToggleRecording_AcceleratorInvoked" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ImportAudioCommand}"
                            MinHeight="48"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowImportAudio), Mode=OneWay}"
                            AutomationProperties.AutomationId="BtnImportAudio"
                            AutomationProperties.Name="{x:Bind local:RecordingPage.ImportLabel()}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock Text="{x:Bind local:RecordingPage.ImportLabel()}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Visibility="{x:Bind local:RecordingPage.InvertBoolToVisibility(ViewModel.IsStatusError), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="420"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="{x:Bind local:RecordingPage.NonEmptyVisibility(ViewModel.StatusText), Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Idle error: sits under the hero. The session copy of this InfoBar lives below the recording bar. -->
        <InfoBar x:Uid="RecordPage_StatusErrorTitle"
                 IsOpen="{x:Bind ViewModel.IsStatusError, Mode=OneWay}"
                 IsClosable="False"
                 Severity="{x:Bind local:RecordingPage.StatusSeverity(ViewModel.StatusText), Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.IsStatusError), Mode=OneWay}"
                 HorizontalAlignment="Stretch"
                 Margin="0,8,0,0"
                 AutomationProperties.AutomationId="InfoIdleStatusError" />

        <!-- Coming up is deliberately quiet: caption header, small icon-only paging, and a single muted line when empty. -->
        <StackPanel Spacing="8"
                    Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowComingUp), Mode=OneWay}"
                    AutomationProperties.AutomationId="ComingUpSection">
            <Grid>
                <TextBlock x:Uid="ComingUp_Heading"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                            Visibility="{x:Bind local:RecordingPage.InvertBoolToVisibility(ViewModel.HasComingUpMessage), Mode=OneWay}">
                    <Button x:Uid="ComingUp_Previous"
                            Command="{x:Bind ViewModel.PreviousComingUpCommand}"
                            Width="40" Height="40"
                            Padding="0"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderThickness="0"
                            AutomationProperties.AutomationId="BtnComingUpPrevious">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button x:Uid="ComingUp_Next"
                            Command="{x:Bind ViewModel.NextComingUpCommand}"
                            Width="40" Height="40"
                            Padding="0"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderThickness="0"
                            AutomationProperties.AutomationId="BtnComingUpNext">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.ComingUpMessage, Mode=OneWay}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.HasComingUpEmptyMessage), Mode=OneWay}"
                       AutomationProperties.AutomationId="TxtComingUpEmpty" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasComingUpError, Mode=OneWay}"
                     IsClosable="False"
                     Severity="{x:Bind local:RecordingPage.ComingUpSeverity(ViewModel.IsComingUpError), Mode=OneWay}"
                     Message="{x:Bind ViewModel.ComingUpMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="InfoComingUp" />
            <ScrollViewer HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Hidden"
                          Padding="0,0,0,4"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.ComingUpEvents, Mode=OneWay}"
                               AutomationProperties.AutomationId="ListComingUp">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:CalendarEvent">
                            <Button MinWidth="200"
                                    MaxWidth="240"
                                    MinHeight="64"
                                    VerticalAlignment="Top"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="12,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Click="ComingUpEvent_Click"
                                    Tag="{x:Bind EventId}"
                                    AutomationProperties.Name="{x:Bind Subject}"
                                    AutomationProperties.AutomationId="{x:Bind local:RecordingPage.ComingUpEventAutomationId(EventId)}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Subject}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind local:RecordingPage.ComingUpWhen(Start, Duration)}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Location}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind local:RecordingPage.NonEmptyVisibility(Location)}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </StackPanel>

        </StackPanel>

        <!-- RECORDING bar: one fixed row (status | mic meter | actions). Copy, highlight feedback and status text live outside it
             (Copy stays in the layout, disabled, and the feedback texts sit in the transcript heading) so the bar never reflows.
             Tab order follows the primary action first: Stop, Pause, Highlight, Copy, Discard. -->
        <Border Style="{StaticResource CardSurface}"
                Padding="16,12"
                Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ColumnSpacing="12" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="18" Height="18" VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw">
                        <Ellipse x:Name="RecordingPulse"
                                 Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                 Opacity="0"
                                 IsHitTestVisible="False"
                                 AutomationProperties.AccessibilityView="Raw" />
                        <Ellipse Width="10" Height="10"
                                 Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                 IsHitTestVisible="False"
                                 AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Uid="RecordPage_ElapsedTime"
                                   Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   AutomationProperties.AutomationId="TxtRecordingElapsed" />
                        <!-- The destination path moved into this title's tooltip; the TextBlock keeps its AutomationId there. -->
                        <TextBlock Text="{x:Bind ViewModel.MeetingTitle, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="TxtRecordingTitle">
                            <ToolTipService.ToolTip>
                                <ToolTip>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDestination.Path, Mode=OneWay, FallbackValue=''}"
                                               TextWrapping="Wrap"
                                               MaxWidth="360"
                                               AutomationProperties.AutomationId="TxtRecordingDestination" />
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                        <!-- The Sources card collapses to this line while recording. -->
                        <TextBlock Text="{x:Bind ViewModel.SourcesSummary, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="TxtRecordingSources" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Column="1"
                             x:Uid="RecordPage_MicLevelBar"
                             Width="96"
                             Value="{x:Bind ViewModel.MicLevel, Mode=OneWay}"
                             Minimum="0" Maximum="100"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowMicPreview), Mode=OneWay}"
                             AutomationProperties.AccessibilityView="Raw"
                             AutomationProperties.AutomationId="ProgressRecordMicrophoneLevel" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            MinHeight="40"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="BtnToggleRecording"
                            AutomationProperties.Name="{x:Bind local:RecordingPage.RecordLabel(ViewModel.IsRecording), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind local:RecordingPage.RecordGlyph(ViewModel.IsRecording), Mode=OneWay}" FontSize="16"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind local:RecordingPage.RecordLabel(ViewModel.IsRecording), Mode=OneWay}" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control"
                                                 Key="R"
                                                 Invoked="ToggleRecording_AcceleratorInvoked" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.TogglePauseCommand}"
                            MinHeight="40"
                            MinWidth="112"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="BtnPauseRecording"
                            AutomationProperties.Name="{x:Bind local:RecordingPage.PauseLabel(ViewModel.IsPaused), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind local:RecordingPage.PauseGlyph(ViewModel.IsPaused), Mode=OneWay}" FontSize="16"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind local:RecordingPage.PauseLabel(ViewModel.IsPaused), Mode=OneWay}" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control"
                                                 Key="P"
                                                 Invoked="TogglePause_AcceleratorInvoked" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button Command="{x:Bind ViewModel.HighlightMomentCommand}"
                            MinHeight="40"
                            MinWidth="40"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind local:RecordingPage.HighlightTooltip()}"
                            AutomationProperties.AutomationId="BtnHighlightMoment"
                            AutomationProperties.Name="{x:Bind local:RecordingPage.HighlightLabel()}">
                        <FontIcon Glyph="&#xE734;" FontSize="16"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                            MinHeight="40"
                            MinWidth="40"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.HasCanvasTranscript, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind local:RecordingPage.CopyLabel()}"
                            AutomationProperties.AutomationId="BtnCopyLiveTranscript"
                            AutomationProperties.Name="{x:Bind local:RecordingPage.CopyLabel()}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                    <!-- Discard is destructive: last in the order, visually separated, and confirmed by a dialog. The lightweight
                         resources keep the critical foreground on hover/press; High Contrast falls back to the system button colors. -->
                    <Button Click="DiscardRecording_Click"
                            Margin="8,0,0,0"
                            MinHeight="40"
                            MinWidth="40"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind local:RecordingPage.DiscardLabel()}"
                            AutomationProperties.AutomationId="BtnDiscardRecording"
                            AutomationProperties.Name="{x:Bind local:RecordingPage.DiscardLabel()}">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlFillColorTransparentBrush" />
                                        <StaticResource x:Key="ButtonForeground" ResourceKey="SystemFillColorCriticalBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemFillColorCriticalBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemFillColorCriticalBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast" />
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <FontIcon Glyph="&#xE74D;" FontSize="16"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift"
                                                 Key="D"
                                                 Invoked="DiscardRecording_AcceleratorInvoked" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PROCESSING bar: replaces the idle column while a session is being transcribed or summarized. -->
        <Border Style="{StaticResource CardSurface}"
                Padding="16,12"
                Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.IsProcessing), Mode=OneWay}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="TxtProcessingStatus" />
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsProcessing, Mode=OneWay}"
                                 AutomationProperties.AutomationId="ProgressProcessing"
                                 HorizontalAlignment="Stretch" />
                </StackPanel>
                <Button Grid.Column="1"
                        x:Uid="RecordPage_CancelProcessing"
                        Command="{x:Bind ViewModel.CancelProcessingCommand}"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnCancelProcessing" />
            </Grid>
        </Border>

        <!-- Session error: the idle column (with its own error InfoBar) is hidden while recording or processing,
             and IsStatusError can fire in both (stop/pause/output-capture failures), so the error stays visible here. -->
        <InfoBar x:Uid="RecordPage_StatusErrorTitle"
                 IsOpen="{x:Bind ViewModel.IsStatusError, Mode=OneWay}"
                 IsClosable="False"
                 Severity="{x:Bind local:RecordingPage.StatusSeverity(ViewModel.StatusText), Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                 Visibility="{x:Bind local:RecordingPage.SessionErrorVisibility(ViewModel.IsStatusError, ViewModel.IsSessionActive), Mode=OneWay}"
                 HorizontalAlignment="Stretch"
                 AutomationProperties.AutomationId="InfoSessionStatusError" />

        <!-- Shown when the chosen app had exited by the time Record was pressed. Lives outside the idle column so it is
             still visible once recording starts. -->
        <InfoBar x:Uid="RecordPage_SourceFallback"
                 IsOpen="{x:Bind ViewModel.AudioSources.IsFallbackOpen, Mode=TwoWay}"
                 Severity="Warning"
                 Message="{x:Bind ViewModel.AudioSources.FallbackMessage, Mode=OneWay}"
                 HorizontalAlignment="Stretch"
                 AutomationProperties.AutomationId="InfoSourceFallback" />

        </StackPanel>

        <!-- Row 1 holds two regions: the transcript column (transcript + docked ask row) and the side panel (answer + notes).
             Narrow: the side panel is a second row under the transcript column. Wide (see LayoutStates): it becomes a fixed-width
             right column. The elements are moved with Grid.Row/Column setters, never duplicated. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" RowSpacing="8" MinHeight="260"
                  Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowTranscriptCanvas), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CanvasHeading, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <!-- LIVE badge: only while audio is actually being captured (hidden when paused). -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind local:RecordingPage.LiveVisibility(ViewModel.IsRecording, ViewModel.IsPaused), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8"
                                         Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                         VerticalAlignment="Center"
                                         IsHitTestVisible="False"
                                         AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Uid="RecordPage_LiveBadge"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="TxtLiveBadge" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Feedback lives here, not in the recording bar, so it can appear without reflowing the controls. -->
                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.HighlightFeedback, Mode=OneWay}"
                                       Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.HasHighlightFeedback), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       MaxWidth="360"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="TxtHighlightFeedback" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       Visibility="{x:Bind local:RecordingPage.InvertBoolToVisibility(ViewModel.IsStatusError), Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxWidth="360"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="TxtRecordingStatus" />
                        </StackPanel>
                        <!-- While recording, Copy lives in the compact control bar; this one serves the saved transcript. -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind local:RecordingPage.InvertBoolToVisibility(ViewModel.IsRecording), Mode=OneWay}">
                            <Button x:Uid="RecordPage_Copy"
                                    Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                                    Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.HasCanvasTranscript), Mode=OneWay}"
                                    AutomationProperties.AutomationId="BtnCopyLiveTranscript" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="24,20"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <ScrollViewer x:Name="LiveTranscriptScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ViewChanged="LiveTranscriptScroll_ViewChanged">
                            <Grid MaxWidth="760">
                                <StackPanel Spacing="8"
                                            Margin="0,24,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Visibility="{x:Bind local:RecordingPage.InvertBoolToVisibility(ViewModel.HasCanvasTranscript), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE720;"
                                              FontSize="24"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock x:Uid="RecordPage_LiveTranscriptHint"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="480" />
                                </StackPanel>
                                <TextBlock x:Name="LiveTranscriptBlock"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           FontSize="16"
                                           LineHeight="26"
                                           IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           LostFocus="LiveTranscriptBlock_LostFocus"
                                           AutomationProperties.AutomationId="TxtLiveTranscriptPreview" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <!-- Both overlays sit over the transcript cell so the row heights never change when they appear. -->
                    <InfoBar x:Uid="RecordPage_CopyConfirmation"
                             Severity="Success"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             MaxWidth="320"
                             Margin="0,12,12,0"
                             IsOpen="{x:Bind ViewModel.IsCopyConfirmationOpen, Mode=TwoWay}"
                             AutomationProperties.AutomationId="InfoCopyLiveTranscript" />
                    <Button x:Name="BtnJumpToLatest"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,20,16"
                            MinHeight="40"
                            MinWidth="40"
                            Visibility="Collapsed"
                            Click="JumpToLatest_Click"
                            ToolTipService.ToolTip="{x:Bind local:RecordingPage.JumpToLatestLabel()}"
                            AutomationProperties.AutomationId="BtnJumpToLatest"
                            AutomationProperties.Name="{x:Bind local:RecordingPage.JumpToLatestLabel()}">
                        <FontIcon Glyph="&#xE74B;" FontSize="16"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Button>
                </Grid>

                <!-- Live-ask dock: chat-composer row under the transcript. The answer card lives in the side panel so it never resizes the transcript. -->
                <StackPanel Grid.Row="2" Spacing="8"
                            Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}">
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.HasArmedQuestion), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <InfoBar Grid.Column="0"
                                 x:Uid="RecordPage_LiveQuestionNotice"
                                 IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Message="{x:Bind ViewModel.ArmedQuestion, Mode=OneWay}"
                                 VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="InfoLiveQuestion" />
                        <Button Grid.Column="1"
                                x:Name="BtnLiveAnswer"
                                x:Uid="RecordPage_LiveAnswer"
                                Command="{x:Bind ViewModel.ConfirmLiveAnswerCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind local:RecordingPage.LiveAnswerTooltip()}"
                                AutomationProperties.AutomationId="BtnLiveAnswer">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator x:Name="LiveAnswerAccelerator"
                                                     Modifiers="Control"
                                                     Key="Enter"
                                                     Invoked="LiveAnswer_AcceleratorInvoked" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button Grid.Column="2"
                                x:Uid="RecordPage_LiveAnswerDismiss"
                                Command="{x:Bind ViewModel.DismissArmedQuestionCommand}"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="BtnLiveAnswerDismiss" />
                    </Grid>
                    <InfoBar x:Uid="RecordPage_LiveAnswerError"
                             IsOpen="{x:Bind ViewModel.HasLiveAnswerError, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Error"
                             Message="{x:Bind ViewModel.LiveAnswerError, Mode=OneWay}"
                             AutomationProperties.AutomationId="InfoLiveAnswerError" />
                    <!-- Question row: names and hints come from the same resources the x:Uid versions used. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtLiveAsk"
                                 AcceptsReturn="False"
                                 PlaceholderText="{x:Bind local:RecordingPage.LiveAskPlaceholder()}"
                                 Text="{x:Bind ViewModel.LiveAskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTipService.ToolTip="{x:Bind local:RecordingPage.LiveAskTooltip()}"
                                 AutomationProperties.Name="{x:Bind local:RecordingPage.LiveAskName()}"
                                 AutomationProperties.AutomationId="TxtLiveAsk">
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator x:Name="LiveAskAccelerator"
                                                     Modifiers="Control"
                                                     Key="Enter"
                                                     Invoked="LiveAsk_AcceleratorInvoked" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>
                        <ToggleButton Grid.Column="1"
                                      x:Uid="RecordPage_WebToggle"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind ViewModel.ForceWebSearch, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanUseWebSearch, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind local:RecordingPage.WebToggleTooltip(ViewModel.CanUseWebSearch), Mode=OneWay}"
                                      AutomationProperties.AutomationId="ToggleLiveWebSearch">
                            <FontIcon Glyph="&#xE774;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                        </ToggleButton>
                        <ProgressRing Grid.Column="2"
                                      x:Uid="RecordPage_LiveAnswerProgress"
                                      IsActive="{x:Bind ViewModel.IsAnswering, Mode=OneWay}"
                                      Width="20"
                                      Height="20"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.IsAnswering), Mode=OneWay}"
                                      AutomationProperties.AutomationId="ProgressLiveAnswer" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Side panel: live answer card + session notes. Only visible while notes are (recording, processing, or a coming-up note). -->
            <Grid x:Name="SidePanel"
                  Grid.Row="1"
                  Grid.Column="0"
                  Margin="0,8,0,0"
                  Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.ShowSessionNotes), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SidePanelFirstRow" Height="Auto" />
                    <RowDefinition x:Name="SidePanelSecondRow" Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="LiveAnswerHost"
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="16"
                            Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.HasLiveAnswer), Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="RecordPage_LiveAnswerHeading"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="RecordPage_WebBadge"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind local:RecordingPage.BoolToVisibility(ViewModel.LiveAnswerUsedWeb), Mode=OneWay}"
                                           AutomationProperties.AutomationId="BadgeLiveAnswerWeb" />
                            </StackPanel>
                            <ScrollViewer MaxHeight="160"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Uid="RecordPage_LiveAnswerText"
                                           Text="{x:Bind ViewModel.LiveAnswerText, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           AutomationProperties.AutomationId="TxtLiveAnswer" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid x:Name="SessionNotesPanel" Grid.Row="1">
                    <TextBox x:Name="TxtRecordingNotes"
                             x:Uid="RecordPage_SessionNotes"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="96"
                             VerticalAlignment="Stretch"
                             Text="{x:Bind ViewModel.SessionNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="Notes_LostFocus"
                             AutomationProperties.AutomationId="TxtRecordingNotes" />
                </Grid>
            </Grid>
        </Grid>

        <!-- RESULT state: the saved meeting is promoted with an accent edge and a success check. Hidden during a session. -->
        <Border Grid.Row="2"
                Style="{StaticResource CardSurface}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="3,1,1,1"
                Padding="16,12"
                Visibility="{x:Bind local:RecordingPage.LastMeetingVisibility(ViewModel.HasLastMeeting, ViewModel.IsSessionActive), Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE73E;"
                          FontSize="16"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                          VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.LastMeetingTitle, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="RecordPage_Open" Click="Open_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="BtnOpenSession" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
