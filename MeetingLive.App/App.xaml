<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MeetingLive_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingLive_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ClaudeBrandBrush" Color="#D97757" />
                    <SolidColorBrush x:Key="FolderAccentBlueBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="FolderAccentTealBrush" Color="#0F766E" />
                    <SolidColorBrush x:Key="FolderAccentGreenBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="FolderAccentAmberBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="FolderAccentOrangeBrush" Color="#C2410C" />
                    <SolidColorBrush x:Key="FolderAccentRedBrush" Color="#B91C1C" />
                    <SolidColorBrush x:Key="FolderAccentPurpleBrush" Color="#6D28D9" />
                    <SolidColorBrush x:Key="FolderAccentNeutralBrush" Color="#64748B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ClaudeBrandBrush" Color="#D97757" />
                    <SolidColorBrush x:Key="FolderAccentBlueBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="FolderAccentTealBrush" Color="#2DD4BF" />
                    <SolidColorBrush x:Key="FolderAccentGreenBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="FolderAccentAmberBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="FolderAccentOrangeBrush" Color="#FB923C" />
                    <SolidColorBrush x:Key="FolderAccentRedBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="FolderAccentPurpleBrush" Color="#A78BFA" />
                    <SolidColorBrush x:Key="FolderAccentNeutralBrush" Color="#94A3B8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ClaudeBrandBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="FolderAccentBlueBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FolderAccentTealBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FolderAccentGreenBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FolderAccentAmberBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FolderAccentOrangeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FolderAccentRedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FolderAccentPurpleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FolderAccentNeutralBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
