<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.AskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    xmlns:icons="using:MeetingLive_App.Controls"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 x:Uid="AskPage_Query"
                 AcceptsReturn="False"
                 Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="BoxAskQuery" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Command="{x:Bind ViewModel.AskCommand}"
                    AutomationProperties.AutomationId="BtnAskJev">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:TypeSafeIcon Width="16" Height="16" />
                    <TextBlock x:Uid="AskPage_Ask" />
                </StackPanel>
            </Button>
            <ProgressRing IsActive="{x:Bind ViewModel.IsAsking, Mode=OneWay}"
                          Width="20"
                          Height="20"
                          Visibility="{x:Bind local:AskPage.BoolToVisibility(ViewModel.IsAsking), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.IsVerdictOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.VerdictSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.VerdictMessage, Mode=OneWay}"
                 IsClosable="True"
                 AutomationProperties.AutomationId="InfoAskVerdict" />

        <Grid Grid.Row="3">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="32"
                          Height="32" />

            <ListView ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                      Visibility="{x:Bind local:AskPage.BoolToVisibility(ViewModel.HasHits), Mode=OneWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="Hits_ItemClick"
                      AutomationProperties.AutomationId="ListAskHits">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AskHitViewModel">
                        <StackPanel Spacing="4" Padding="0,8">
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ScorePercent, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
