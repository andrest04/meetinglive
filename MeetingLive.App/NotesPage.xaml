<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MeetingLive_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <TextBox x:Uid="NotesPage_Notes"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 LostFocus="Notes_LostFocus"
                 Visibility="{x:Bind local:NotesPage.BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}"
                 AutomationProperties.AutomationId="TxtMeetingNotes" />
    </Grid>
</Page>
