<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MeetingLive_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <SelectorBar x:Name="NotesModeBar"
                     Grid.Row="0"
                     SelectionChanged="NotesMode_SelectionChanged"
                     Visibility="{x:Bind local:NotesPage.BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}"
                     AutomationProperties.AutomationId="SelectorNotesMode">
            <SelectorBarItem x:Uid="NotesMode_MyNotes"
                             Tag="notes"
                             IsSelected="True"
                             AutomationProperties.AutomationId="SelectorMyNotes" />
            <SelectorBarItem x:Uid="NotesMode_Enhanced"
                             Tag="enhanced"
                             AutomationProperties.AutomationId="SelectorEnhanced" />
        </SelectorBar>
        <TextBox x:Uid="NotesPage_Notes"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 LostFocus="Notes_LostFocus"
                 Visibility="{x:Bind local:NotesPage.BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}"
                 AutomationProperties.AutomationId="TxtMeetingNotes" />
    </Grid>
</Page>
