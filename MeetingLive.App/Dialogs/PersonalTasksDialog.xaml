<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MeetingLive_App.Dialogs.PersonalTasksDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App.Dialogs"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    xmlns:md="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:icons="using:MeetingLive_App.Controls"
    mc:Ignorable="d"
    x:Uid="PersonalTasks_Title"
    DefaultButton="Close">

    <Grid RowSpacing="12" MinWidth="440" MaxWidth="440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 x:Uid="PersonalTasks_Topic"
                 AcceptsReturn="False"
                 Text="{x:Bind ViewModel.Topic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="BoxAskTopic" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button Command="{x:Bind ViewModel.AskCommand}"
                    AutomationProperties.AutomationId="BtnAskJev">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:TypeSafeIcon Width="16" Height="16" />
                    <TextBlock x:Uid="PersonalTasks_Do" />
                </StackPanel>
            </Button>
            <ProgressRing IsActive="{x:Bind ViewModel.IsAsking, Mode=OneWay}"
                          Width="20"
                          Height="20"
                          Visibility="{x:Bind local:PersonalTasksDialog.BoolToVisibility(ViewModel.IsAsking), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar Grid.Row="2"
                 IsOpen="{x:Bind ViewModel.IsVerdictOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.VerdictSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.VerdictMessage, Mode=OneWay}"
                 IsClosable="True"
                 AutomationProperties.AutomationId="InfoAskVerdict" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="32"
                          Height="32"
                          Grid.RowSpan="3" />

            <ScrollViewer Grid.Row="0"
                          MaxHeight="280"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind local:PersonalTasksDialog.BoolToVisibility(ViewModel.HasChecklist), Mode=OneWay}">
                <md:MarkdownTextBlock Text="{x:Bind ViewModel.ChecklistMarkdown, Mode=OneWay}"
                                      TextWrapping="WrapWholeWords"
                                      Background="Transparent"
                                      AutomationProperties.AutomationId="TxtAskChecklist" />
            </ScrollViewer>

            <TextBlock Grid.Row="1"
                       x:Uid="PersonalTasks_FromTranscript"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,0"
                       Visibility="{x:Bind local:PersonalTasksDialog.BoolToVisibility(ViewModel.HasHits), Mode=OneWay}" />

            <ListView Grid.Row="2"
                      MaxHeight="240"
                      ItemsSource="{x:Bind ViewModel.Hits, Mode=OneWay}"
                      Visibility="{x:Bind local:PersonalTasksDialog.BoolToVisibility(ViewModel.HasHits), Mode=OneWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="Hits_ItemClick"
                      AutomationProperties.AutomationId="ListAskHits">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AskHitViewModel">
                        <StackPanel Spacing="4" Padding="0,8">
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ScorePercent, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</ContentDialog>
