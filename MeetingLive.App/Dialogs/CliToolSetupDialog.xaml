<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MeetingLive_App.Dialogs.CliToolSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Retry"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="16" MinWidth="420" MaxWidth="420">
        <TextBlock x:Name="InstructionsText" TextWrapping="Wrap" AutomationProperties.AutomationId="TxtCliSetupInstructions" />
        <InfoBar x:Name="StatusInfoBar" IsOpen="True" Severity="Warning" Title="Not found on PATH" />
    </StackPanel>
</ContentDialog>
