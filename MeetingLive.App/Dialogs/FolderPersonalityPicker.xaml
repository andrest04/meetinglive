<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MeetingLive_App.Dialogs.FolderPersonalityPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App.Dialogs"
    mc:Ignorable="d">

    <StackPanel Spacing="16" MinWidth="400" MaxWidth="440">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="PreviewDot"
                    Width="8" Height="8" CornerRadius="4"
                    VerticalAlignment="Center" />
            <FontIcon x:Name="PreviewIcon"
                      FontSize="16"
                      VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind FolderName}"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="LibraryPersonality_ColorHeader"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <GridView x:Name="ColorGrid"
                      ItemsSource="{x:Bind ColorOptions}"
                      SelectionMode="Single"
                      SelectionChanged="ColorGrid_SelectionChanged"
                      AutomationProperties.AutomationId="GridLibraryPersonalityColor">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:FolderColorSwatch">
                        <Border Width="28" Height="28" CornerRadius="14"
                                Background="{x:Bind Brush}"
                                AutomationProperties.Name="{x:Bind Key}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="LibraryPersonality_IconHeader"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <GridView x:Name="IconGrid"
                      ItemsSource="{x:Bind IconOptions}"
                      SelectionMode="Single"
                      MaxHeight="220"
                      SelectionChanged="IconGrid_SelectionChanged"
                      AutomationProperties.AutomationId="GridLibraryPersonalityIcon">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:FolderIconTile">
                        <Border Width="40" Height="40"
                                AutomationProperties.Name="{x:Bind Key}">
                            <FontIcon Glyph="{x:Bind Glyph}"
                                      FontSize="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </StackPanel>
</UserControl>
