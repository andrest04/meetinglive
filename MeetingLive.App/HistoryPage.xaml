<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    xmlns:models="using:MeetingLive.Core.Models"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="820" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FolderSplitView.DisplayMode" Value="Overlay" />
                        <Setter Target="FolderSplitView.IsPaneOpen" Value="False" />
                        <!-- Overlay floats over the list, so it needs a solid surface; inline (wide) stays transparent. -->
                        <Setter Target="FolderSplitView.PaneBackground" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        <Setter Target="FoldersToggleButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="HistoryPage_Title" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="FoldersToggleButton"
                              Visibility="Collapsed"
                              IsChecked="{Binding ElementName=FolderSplitView, Path=IsPaneOpen, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind local:HistoryPage.FoldersToggleLabel()}"
                              AutomationProperties.AutomationId="BtnLibraryFoldersToggle">
                    <FontIcon Glyph="&#xE8B7;" />
                </ToggleButton>
                <Button Click="NewFolder_Click"
                        AutomationProperties.AutomationId="BtnLibraryNewFolder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                        <TextBlock x:Uid="Library_NewFolderLabel" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <BreadcrumbBar ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}"
                           ItemClicked="BreadcrumbBar_ItemClicked"
                           AutomationProperties.AutomationId="BreadcrumbLibrary" />
            <AutoSuggestBox Grid.Column="1"
                            x:Uid="Library_Search"
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.AutomationId="TxtLibrarySearch" />
        </Grid>

        <Grid Grid.Row="2">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />

            <SplitView x:Name="FolderSplitView"
                       Visibility="{x:Bind local:HistoryPage.InvertBoolToVisibility(ViewModel.IsLoading), Mode=OneWay}"
                       IsPaneOpen="True"
                       DisplayMode="Inline"
                       PaneBackground="Transparent"
                       PanePlacement="Left"
                       OpenPaneLength="260">
                <SplitView.Pane>
                <Border Style="{StaticResource CardSurface}"
                        Margin="0,0,16,0"
                        Padding="4,8">
                    <TreeView ItemsSource="{x:Bind ViewModel.FolderNodes}"
                              ItemInvoked="FolderTree_ItemInvoked"
                              RightTapped="FolderTree_RightTapped"
                              SelectionMode="Single"
                              AutomationProperties.AutomationId="TreeLibraryFolders">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}"
                                              IsExpanded="{x:Bind IsExpanded, Mode=OneWay}">
                                    <TreeViewItem.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind local:HistoryPage.FolderAccentBrush(ColorKey, FolderId)}"
                                                    Opacity="{x:Bind local:HistoryPage.FolderAccentOpacity(FolderId)}" />
                                            <FontIcon Glyph="{x:Bind local:HistoryPage.FolderGlyph(FolderId, IconKey)}"
                                                      FontSize="16"
                                                      Foreground="{x:Bind local:HistoryPage.FolderAccentBrush(ColorKey, FolderId)}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </TreeViewItem.Content>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
                </SplitView.Pane>

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Uid="Library_FolderNote"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="120"
                             Text="{x:Bind ViewModel.FolderNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.IsRealFolderSelected), Mode=OneWay}"
                             AutomationProperties.AutomationId="TxtLibraryFolderNote" />

                    <InfoBar Grid.Row="1"
                             Severity="Warning"
                             IsClosable="True"
                             IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                             AutomationProperties.AutomationId="InfoLibraryStatus" />

                    <Grid Grid.Row="2">
                        <StackPanel Spacing="12"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ShowLibraryEmpty), Mode=OneWay}">
                            <TextBlock x:Uid="HistoryPage_Empty"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <Button x:Uid="HistoryPage_EmptyCta"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Click="EmptyCta_Click"
                                    AutomationProperties.AutomationId="BtnHistoryEmptyRecord" />
                        </StackPanel>

                        <TextBlock x:Uid="Library_InboxEmpty"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ShowInboxEmpty), Mode=OneWay}" />

                        <TextBlock x:Uid="Library_FolderEmpty"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ShowFolderEmpty), Mode=OneWay}" />

                          <ListView ItemsSource="{x:Bind ViewModel.Meetings, Mode=OneWay}"
                                   Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.HasMeetings), Mode=OneWay}"
                                   SelectionMode="None"
                                   IsItemClickEnabled="True"
                                   ItemClick="Meetings_ItemClick"
                                   AutomationProperties.AutomationId="ListMeetingHistory">
                             <ListView.ItemContainerStyle>
                                 <Style TargetType="ListViewItem">
                                     <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                     <Setter Property="Padding" Value="0" />
                                     <Setter Property="Margin" Value="0,0,0,8" />
                                 </Style>
                             </ListView.ItemContainerStyle>
                             <ListView.ItemTemplate>
                                 <DataTemplate x:DataType="models:MeetingRecord">
                                     <Border Style="{StaticResource CardSurface}"
                                             Tag="{x:Bind Id}"
                                             ContextRequested="MeetingRow_ContextRequested"
                                             Padding="16,12">
                                         <!-- Title and date share the first line (date right-aligned, caption), snippet below.
                                              The overflow button is subtle so the row content leads; the whole row stays the click target. -->
                                         <Grid ColumnSpacing="12" RowSpacing="2">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>

                                             <TextBlock Text="{x:Bind Title}"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                             <TextBlock Grid.Column="1"
                                                        Text="{x:Bind local:HistoryPage.FormattedDate(RecordedAt)}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        VerticalAlignment="Center" />
                                             <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                        Text="{x:Bind local:HistoryPage.Snippet(Summary, Transcript)}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextTrimming="CharacterEllipsis" MaxLines="1" />

                                             <Button Grid.Column="2" Grid.RowSpan="2"
                                                     x:Uid="HistoryRow_More" Click="MeetingMore_Click" Tag="{x:Bind Id}"
                                                     Width="36" Height="36" Padding="0"
                                                     VerticalAlignment="Center"
                                                     Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                                     BorderThickness="0"
                                                     AutomationProperties.AutomationId="BtnHistoryMore">
                                                 <FontIcon Glyph="&#xE712;" FontSize="16" />
                                             </Button>
                                         </Grid>
                                     </Border>
                                 </DataTemplate>
                             </ListView.ItemTemplate>
                         </ListView>
                    </Grid>
                </Grid>
            </SplitView>
        </Grid>
    </Grid>
</Page>
