<?xml version="1.0" encoding="utf-8" ?>
<!--
    Five rounded bars that follow a 0..100 level, like the activity meter in a recording capsule.
    Heights are driven from code (AudioBarsControl.xaml.cs); the bars rest as flat dots when idle.
-->
<UserControl
    x:Class="MeetingLive_App.Controls.AudioBarsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">

    <StackPanel x:Name="BarsPanel"
                Orientation="Horizontal"
                Spacing="3"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <Rectangle x:Name="Bar0" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5"
                   VerticalAlignment="Center" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
        <Rectangle x:Name="Bar1" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5"
                   VerticalAlignment="Center" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
        <Rectangle x:Name="Bar2" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5"
                   VerticalAlignment="Center" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
        <Rectangle x:Name="Bar3" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5"
                   VerticalAlignment="Center" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
        <Rectangle x:Name="Bar4" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5"
                   VerticalAlignment="Center" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
    </StackPanel>
</UserControl>
