<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    xmlns:models="using:MeetingLive.Core.Models"
    xmlns:services="using:MeetingLive.Core.Services"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:icons="using:MeetingLive_App.Controls"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24" Spacing="24" MaxWidth="720" HorizontalAlignment="Stretch">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Summary models (local GGUF, downloaded on demand) -->
            <StackPanel Spacing="4">
                <TextBlock Text="Summary models" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Runs entirely on this PC — no account, no server, no cost. Download the models you want to use and pick one as active; delete any you no longer need to reclaim disk space."
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />

                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModelOption">
                            <controls:SettingsCard Header="{x:Bind Info.DisplayName}"
                                                    Description="{x:Bind SpeedQualityLabel}"
                                                    Margin="0,0,0,4">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE945;" />
                                </controls:SettingsCard.HeaderIcon>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" VerticalAlignment="Center"
                                            Background="{x:Bind RatingBrush}">
                                        <TextBlock Text="{x:Bind RatingLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>

                                    <ProgressRing IsActive="{x:Bind IsDownloading, Mode=OneWay}" Width="16" Height="16" />

                                    <RadioButton Content="Active"
                                                 GroupName="SummaryModelSelection"
                                                 IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                                 IsEnabled="{x:Bind IsDownloaded, Mode=OneWay}"
                                                 Checked="ModelRadioButton_Checked"
                                                 AutomationProperties.AutomationId="{x:Bind local:SettingsPage.ActiveRadioId(Info.FileName), Mode=OneWay}" />

                                    <Button Content="Download"
                                            Click="DownloadModelButton_Click"
                                            Visibility="{x:Bind local:SettingsPage.InverseBoolToVisibility(IsDownloaded), Mode=OneWay}"
                                            IsEnabled="{x:Bind local:SettingsPage.Not(IsDownloading), Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind local:SettingsPage.DownloadButtonId(Info.FileName), Mode=OneWay}" />

                                    <Button Content="Delete"
                                            Click="DeleteModelButton_Click"
                                            Visibility="{x:Bind local:SettingsPage.BoolToVisibility(IsDownloaded), Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind local:SettingsPage.DeleteButtonId(Info.FileName), Mode=OneWay}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Summary provider -->
            <StackPanel Spacing="4">
                <TextBlock Text="Summary provider" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard Header="Choose where summaries are generated"
                                        Description="Local runs entirely on this PC for free. Claude Code and Codex use an already-installed, already-authenticated CLI."
                                        ContentAlignment="Left">
                    <StackPanel Spacing="8">
                        <RadioButtons AutomationProperties.AutomationId="RadioSummaryProvider">
                            <RadioButton IsChecked="{x:Bind ViewModel.IsLocalSelected, Mode=OneWay}"
                                         Checked="ProviderRadioButton_Checked" Tag="Local"
                                         AutomationProperties.AutomationId="RadioProviderLocal">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Width="16" Height="16" FontSize="16" Glyph="&#xE950;" />
                                    <TextBlock Text="Local (on this device)" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{x:Bind ViewModel.IsClaudeCodeSelected, Mode=OneWay}"
                                         Checked="ProviderRadioButton_Checked" Tag="ClaudeCode"
                                         AutomationProperties.AutomationId="RadioProviderClaudeCode">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:ClaudeCodeIcon Width="16" Height="16" />
                                    <TextBlock Text="Claude Code CLI" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{x:Bind ViewModel.IsCodexSelected, Mode=OneWay}"
                                         Checked="ProviderRadioButton_Checked" Tag="Codex"
                                         AutomationProperties.AutomationId="RadioProviderCodex">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:CodexIcon Width="16" Height="16" />
                                    <TextBlock Text="Codex CLI" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Text="{x:Bind ViewModel.CliProviderStatusText, Mode=OneWay}"
                                   Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.ShowCliProviderStatus), Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                   AutomationProperties.AutomationId="TxtCliProviderStatus" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <!-- Microphone -->
            <StackPanel Spacing="4">
                <TextBlock Text="Microphone" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard Header="Recording device"
                                        Description="Which physical microphone MeetingLive records your voice from. System default follows whatever Windows currently uses."
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE720;}">
                    <ComboBox ItemsSource="{x:Bind ViewModel.Microphones}"
                              SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=OneWay}"
                              SelectionChanged="MicrophoneComboBox_SelectionChanged"
                              AutomationProperties.AutomationId="ComboMicrophoneDevice">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:MicrophoneDeviceOption">
                                <TextBlock Text="{x:Bind Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="Microphone level" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ProgressBar Value="{x:Bind ViewModel.MicLevel, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 HorizontalAlignment="Stretch"
                                 AutomationProperties.AutomationId="ProgressMicrophoneLevel"
                                 AutomationProperties.Name="Microphone level" />
                </StackPanel>
            </StackPanel>

            <!-- Meeting language -->
            <StackPanel Spacing="4">
                <TextBlock Text="Meeting language" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard Header="Transcription language"
                                        Description="Pin the meeting language so transcription does not have to guess. Auto-detect is fine when meetings mix languages or you are not sure."
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE775;}">
                    <ComboBox ItemsSource="{x:Bind ViewModel.Languages}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=OneWay}"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              AutomationProperties.AutomationId="ComboMeetingLanguage">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TranscriptionLanguageOption">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>

            <!-- Transcription engine -->
            <StackPanel Spacing="4">
                <TextBlock Text="Transcription" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard Header="Nemotron 3.5 ASR Streaming 0.6B"
                                        Description="~0.74 GB model; runtime extra (CPU ~5 MB or CUDA ~106 MB). Official NVIDIA binaries — nothing else to install."
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Download"
                                Command="{x:Bind ViewModel.DownloadTranscriptionEngineCommand}"
                                Visibility="{x:Bind local:SettingsPage.InverseBoolToVisibility(ViewModel.IsTranscriptionEngineInstalled), Mode=OneWay}"
                                IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsTranscriptionDownloading), Mode=OneWay}"
                                AutomationProperties.AutomationId="BtnDownloadTranscriptionEngine" />
                        <Button Content="Delete"
                                Command="{x:Bind ViewModel.DeleteTranscriptionEngineCommand}"
                                Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsTranscriptionEngineInstalled), Mode=OneWay}"
                                AutomationProperties.AutomationId="BtnDeleteTranscriptionEngine" />
                    </StackPanel>
                </controls:SettingsCard>
                <StackPanel Spacing="4"
                            Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsTranscriptionDownloading), Mode=OneWay}">
                    <ProgressBar Value="{x:Bind ViewModel.TranscriptionDownloadProgressPercent, Mode=OneWay}"
                                 Maximum="100"
                                 HorizontalAlignment="Stretch"
                                 AutomationProperties.AutomationId="ProgressTranscriptionEngineDownload"
                                 AutomationProperties.Name="Transcription engine download progress" />
                    <TextBlock Text="{x:Bind ViewModel.TranscriptionDownloadStatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TxtTranscriptionDownloadStatus" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.TranscriptionAccelerationCaption, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                           AutomationProperties.AutomationId="TxtTranscriptionAcceleration" />
            </StackPanel>

            <!-- Live transcription -->
            <StackPanel Spacing="4">
                <TextBlock Text="Recording" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard Header="Live transcription during recording"
                                        Description="True streaming with Nemotron 3.5 ASR while you record. Turning this off only defers transcription until you stop — still Nemotron, not a preview."
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE90A;}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsLiveTranscriptionEnabled, Mode=OneWay}"
                                  Toggled="LiveTranscriptionToggleSwitch_Toggled"
                                  AutomationProperties.AutomationId="ToggleLiveTranscription" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- Data location -->
            <StackPanel Spacing="4">
                <TextBlock Text="Data" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard Header="Data location"
                                        Description="{x:Bind ViewModel.DataDirectoryPath}"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
                    <Button Content="Open folder"
                            Command="{x:Bind ViewModel.OpenDataFolderCommand}"
                            AutomationProperties.AutomationId="BtnOpenDataFolder" />
                </controls:SettingsCard>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
