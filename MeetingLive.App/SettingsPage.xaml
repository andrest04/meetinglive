<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    xmlns:models="using:MeetingLive.Core.Models"
    xmlns:services="using:MeetingLive.Core.Services"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:icons="using:MeetingLive_App.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24" Spacing="24" MaxWidth="720" HorizontalAlignment="Stretch">

            <TextBlock x:Uid="SettingsPage_Title" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Summary provider. Local GGUF models accordion below the radios so the
                 provider choice never jumps; it collapses away for Claude Code / Codex. -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_SummaryProvider" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard x:Uid="Settings_SummaryProviderCard"
                                        ContentAlignment="Left">
                    <StackPanel Spacing="8">
                        <RadioButtons AutomationProperties.AutomationId="RadioSummaryProvider">
                            <RadioButton IsChecked="{x:Bind ViewModel.IsLocalSelected, Mode=OneWay}"
                                         Checked="ProviderRadioButton_Checked" Tag="Local"
                                         AutomationProperties.AutomationId="RadioProviderLocal">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Width="16" Height="16" FontSize="16" Glyph="&#xE950;" />
                                    <TextBlock x:Uid="Settings_ProviderLocal" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{x:Bind ViewModel.IsClaudeCodeSelected, Mode=OneWay}"
                                         Checked="ProviderRadioButton_Checked" Tag="ClaudeCode"
                                         AutomationProperties.AutomationId="RadioProviderClaudeCode">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:ClaudeCodeIcon Width="16" Height="16" />
                                    <TextBlock x:Uid="Settings_ProviderClaude" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{x:Bind ViewModel.IsCodexSelected, Mode=OneWay}"
                                         Checked="ProviderRadioButton_Checked" Tag="Codex"
                                         AutomationProperties.AutomationId="RadioProviderCodex">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:CodexIcon Width="16" Height="16" />
                                    <TextBlock x:Uid="Settings_ProviderCodex" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{x:Bind ViewModel.IsXaiSelected, Mode=OneWay}"
                                         Checked="ProviderRadioButton_Checked" Tag="Xai"
                                         AutomationProperties.AutomationId="RadioProviderXai">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:GrokIcon Width="16" Height="16" />
                                    <TextBlock x:Uid="Settings_ProviderXai" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Text="{x:Bind ViewModel.CliProviderStatusText, Mode=OneWay}"
                                   Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.ShowCliProviderStatus), Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                   AutomationProperties.AutomationId="TxtCliProviderStatus" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsExpander x:Uid="Settings_ClaudeOptions"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE9F9;}"
                                           IsExpanded="True"
                                           Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsClaudeCodeSelected), Mode=OneWay}"
                                           AutomationProperties.AutomationId="ExpanderClaudeOptions">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="Settings_ClaudeModel">
                            <ComboBox MinWidth="200"
                                      ItemsSource="{x:Bind ViewModel.ClaudeModels, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedClaudeModelId, Mode=OneWay}"
                                      SelectionChanged="ClaudeModelComboBox_SelectionChanged"
                                      AutomationProperties.AutomationId="ComboClaudeModel" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Settings_ClaudeEffort">
                            <ComboBox MinWidth="160"
                                      ItemsSource="{x:Bind ViewModel.ClaudeEfforts, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedClaudeEffort, Mode=OneWay}"
                                      SelectionChanged="ClaudeEffortComboBox_SelectionChanged"
                                      AutomationProperties.AutomationId="ComboClaudeEffort" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Uid="Settings_CodexOptions"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE9F9;}"
                                           IsExpanded="True"
                                           Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsCodexSelected), Mode=OneWay}"
                                           AutomationProperties.AutomationId="ExpanderCodexOptions">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="Settings_CodexModel">
                            <ComboBox MinWidth="200"
                                      ItemsSource="{x:Bind ViewModel.CodexModels, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCodexModelId, Mode=OneWay}"
                                      SelectionChanged="CodexModelComboBox_SelectionChanged"
                                      AutomationProperties.AutomationId="ComboCodexModel" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Settings_CodexEffort">
                            <ComboBox MinWidth="160"
                                      ItemsSource="{x:Bind ViewModel.CodexEfforts, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCodexEffort, Mode=OneWay}"
                                      SelectionChanged="CodexEffortComboBox_SelectionChanged"
                                      AutomationProperties.AutomationId="ComboCodexEffort" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Uid="Settings_SummaryModels"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE945;}"
                                           IsExpanded="{x:Bind ViewModel.IsLocalSelected, Mode=OneWay}"
                                           Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsLocalSelected), Mode=OneWay}"
                                           ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                                           AutomationProperties.AutomationId="ExpanderLocalSummaryModels">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModelOption">
                            <controls:SettingsCard Header="{x:Bind Info.DisplayName}"
                                                    Description="{x:Bind SpeedQualityLabel}">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE945;" />
                                </controls:SettingsCard.HeaderIcon>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border CornerRadius="{ThemeResource ControlCornerRadius}" Padding="8,4" VerticalAlignment="Center"
                                            Background="{x:Bind local:FitRatingPresentation.Brush(Rating), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind RatingLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>

                                    <ProgressRing IsActive="{x:Bind IsDownloading, Mode=OneWay}" Width="16" Height="16" />

                                    <RadioButton x:Uid="Settings_Active"
                                                 GroupName="SummaryModelSelection"
                                                 IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                                 IsEnabled="{x:Bind IsDownloaded, Mode=OneWay}"
                                                 Checked="ModelRadioButton_Checked"
                                                 AutomationProperties.AutomationId="{x:Bind local:SettingsPage.ActiveRadioId(Info.FileName), Mode=OneWay}" />

                                    <Button x:Uid="Settings_Download"
                                            Click="DownloadModelButton_Click"
                                            Visibility="{x:Bind local:SettingsPage.InverseBoolToVisibility(IsDownloaded), Mode=OneWay}"
                                            IsEnabled="{x:Bind local:SettingsPage.Not(IsDownloading), Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind local:SettingsPage.DownloadButtonId(Info.FileName), Mode=OneWay}" />

                                    <Button x:Uid="Settings_Delete"
                                            Click="DeleteModelButton_Click"
                                            Visibility="{x:Bind local:SettingsPage.BoolToVisibility(IsDownloaded), Mode=OneWay}"
                                            AutomationProperties.AutomationId="{x:Bind local:SettingsPage.DeleteButtonId(Info.FileName), Mode=OneWay}" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Uid="Settings_XaiAccount"
                                           IsExpanded="True"
                                           Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsXaiSelected), Mode=OneWay}"
                                           AutomationProperties.AutomationId="ExpanderXaiAccount">
                    <controls:SettingsExpander.HeaderIcon>
                        <PathIcon Data="F0 M9.27 15.29l7.978-5.897c.391-.29.95-.177 1.137.272.98 2.369.542 5.215-1.41 7.169-1.951 1.954-4.667 2.382-7.149 1.406l-2.711 1.257c3.889 2.661 8.611 2.003 11.562-.953 2.341-2.344 3.066-5.539 2.388-8.42l.006.007c-.983-4.232.242-5.924 2.75-9.383.06-.082.12-.164.179-.248l-3.301 3.305v-.01L9.267 15.292M7.623 16.723c-2.792-2.67-2.31-6.801.071-9.184 1.761-1.763 4.647-2.483 7.166-1.425l2.705-1.25a7.808 7.808 0 00-1.829-1A8.975 8.975 0 005.984 5.83c-2.533 2.536-3.33 6.436-1.962 9.764 1.022 2.487-.653 4.246-2.34 6.022-.599.63-1.199 1.259-1.682 1.925l7.62-6.815" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="{x:Bind ViewModel.XaiStatusText, Mode=OneWay}"
                                               Description="{x:Bind ViewModel.XaiStatusDetail, Mode=OneWay}"
                                               AutomationProperties.AutomationId="CardXaiStatus">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE73E;"
                                          Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsXaiSignedIn), Mode=OneWay}" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsXaiBusy, Mode=OneWay}"
                                              Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsXaiBusy), Mode=OneWay}"
                                              Width="16" Height="16" />
                                <Button x:Uid="Settings_XaiSignIn"
                                        Click="XaiSignIn_Click"
                                        Visibility="{x:Bind local:SettingsPage.InverseBoolToVisibility(ViewModel.IsXaiSignedIn), Mode=OneWay}"
                                        AutomationProperties.AutomationId="BtnXaiSignIn" />
                                <Button x:Uid="Settings_XaiSignOut"
                                        Click="XaiSignOut_Click"
                                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsXaiSignedIn), Mode=OneWay}"
                                        AutomationProperties.AutomationId="BtnXaiSignOut" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Settings_XaiApiKey" ContentAlignment="Vertical">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PasswordBox x:Uid="Settings_XaiApiKeyBox"
                                             Width="240"
                                             PasswordRevealMode="Peek"
                                             PasswordChanged="XaiApiKey_PasswordChanged"
                                             AutomationProperties.AutomationId="BoxSettingsXaiApiKey" />
                                <Button x:Uid="Settings_XaiSaveApiKey"
                                        Click="XaiSaveApiKey_Click"
                                        IsEnabled="{x:Bind ViewModel.CanSaveXaiApiKey, Mode=OneWay}"
                                        AutomationProperties.AutomationId="BtnXaiSaveApiKeySettings" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Settings_XaiModel">
                            <ComboBox x:Uid="ComboXaiModel"
                                      MinWidth="200"
                                      ItemsSource="{x:Bind ViewModel.XaiModels, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedXaiModelId, Mode=OneWay}"
                                      SelectionChanged="XaiModelComboBox_SelectionChanged"
                                      IsEnabled="{x:Bind ViewModel.IsXaiSignedIn, Mode=OneWay}"
                                      AutomationProperties.AutomationId="ComboXaiModel" />
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Settings_XaiEffort">
                            <ComboBox MinWidth="160"
                                      ItemsSource="{x:Bind ViewModel.XaiEfforts, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedXaiEffort, Mode=OneWay}"
                                      SelectionChanged="XaiEffortComboBox_SelectionChanged"
                                      IsEnabled="{x:Bind ViewModel.IsXaiSignedIn, Mode=OneWay}"
                                      AutomationProperties.AutomationId="ComboXaiEffort" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <InfoBar IsOpen="{x:Bind ViewModel.IsXaiFeedbackOpen, Mode=TwoWay}"
                         Severity="Success"
                         Message="{x:Bind ViewModel.XaiFeedbackMessage, Mode=OneWay}"
                         AutomationProperties.AutomationId="InfoXaiFeedback" />
            </StackPanel>

            <!-- Microphone -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_Microphone" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard x:Uid="Settings_RecordingDevice"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE720;}"
                                        ContentAlignment="Vertical">
                    <ComboBox x:Uid="ComboMicrophoneDevice"
                              ItemsSource="{x:Bind ViewModel.Microphones, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              MinWidth="280"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="MicrophoneComboBox_SelectionChanged"
                              AutomationProperties.AutomationId="ComboMicrophoneDevice" />
                </controls:SettingsCard>

                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock x:Uid="Settings_MicLevel" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <ProgressBar Value="{x:Bind ViewModel.MicLevel, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 HorizontalAlignment="Stretch"
                                 AutomationProperties.AutomationId="ProgressMicrophoneLevel"
                                 AutomationProperties.Name="Microphone level" />
                </StackPanel>
            </StackPanel>

            <!-- Meeting language -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_MeetingLanguage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard x:Uid="Settings_TranscriptionLanguage"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE775;}">
                    <ComboBox ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=OneWay}"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              AutomationProperties.AutomationId="ComboMeetingLanguage">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TranscriptionLanguageOption">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard x:Uid="Settings_SummaryLanguage"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE8D2;}">
                    <ComboBox ItemsSource="{x:Bind ViewModel.SummaryLanguages, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSummaryLanguage, Mode=OneWay}"
                              SelectionChanged="SummaryLanguageComboBox_SelectionChanged"
                              AutomationProperties.AutomationId="ComboSummaryLanguage">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TranscriptionLanguageOption">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>

            <!-- Transcription engine -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_Transcription" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard x:Uid="Settings_NemotronCard"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="Settings_DownloadEngine"
                                Command="{x:Bind ViewModel.DownloadTranscriptionEngineCommand}"
                                Visibility="{x:Bind local:SettingsPage.InverseBoolToVisibility(ViewModel.IsTranscriptionEngineInstalled), Mode=OneWay}"
                                IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsTranscriptionDownloading), Mode=OneWay}"
                                AutomationProperties.AutomationId="BtnDownloadTranscriptionEngine" />
                        <Button x:Uid="Settings_DeleteEngine"
                                Command="{x:Bind ViewModel.DeleteTranscriptionEngineCommand}"
                                Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsTranscriptionEngineInstalled), Mode=OneWay}"
                                AutomationProperties.AutomationId="BtnDeleteTranscriptionEngine" />
                    </StackPanel>
                </controls:SettingsCard>
                <StackPanel Spacing="4"
                            Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsTranscriptionDownloading), Mode=OneWay}">
                    <ProgressBar Value="{x:Bind ViewModel.TranscriptionDownloadProgressPercent, Mode=OneWay}"
                                 Maximum="100"
                                 HorizontalAlignment="Stretch"
                                 AutomationProperties.AutomationId="ProgressTranscriptionEngineDownload"
                                 AutomationProperties.Name="Transcription engine download progress" />
                    <TextBlock Text="{x:Bind ViewModel.TranscriptionDownloadStatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TxtTranscriptionDownloadStatus" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.TranscriptionAccelerationCaption, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                           AutomationProperties.AutomationId="TxtTranscriptionAcceleration" />

            </StackPanel>

            <!-- Live transcription -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_Recording" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard x:Uid="Settings_LiveTranscription"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE90A;}">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsLiveTranscriptionEnabled, Mode=OneWay}"
                                  Toggled="LiveTranscriptionToggleSwitch_Toggled"
                                  AutomationProperties.AutomationId="ToggleLiveTranscription" />
                </controls:SettingsCard>
            </StackPanel>

            <!-- Data location -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Settings_Data" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <controls:SettingsCard x:Uid="Settings_MeetingsLocation"
                                         Description="{x:Bind ViewModel.MeetingsFolderPath, Mode=OneWay}"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}"
                                        AutomationProperties.AutomationId="CardMeetingsLocation">
                    <Button x:Uid="Settings_OpenFolder"
                            Command="{x:Bind ViewModel.OpenDataFolderCommand}"
                            AutomationProperties.AutomationId="BtnOpenMeetingsFolder" />
                </controls:SettingsCard>
                <controls:SettingsCard x:Uid="Settings_AppDataLocation"
                                         Description="{x:Bind ViewModel.AppDataDirectoryPath, Mode=OneWay}"
                                        HeaderIcon="{ui:FontIcon Glyph=&#xE115;}"
                                        IsActionIconVisible="False"
                                        AutomationProperties.AutomationId="CardAppDataLocation" />
            </StackPanel>

            <!-- About (informational only; not a navigation target) -->
            <controls:SettingsCard x:Uid="Settings_About"
                                   Description="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                   HeaderIcon="{ui:FontIcon Glyph=&#xE946;}"
                                   IsActionIconVisible="False"
                                   AutomationProperties.AutomationId="CardAbout" />

        </StackPanel>
    </ScrollViewer>
</Page>
