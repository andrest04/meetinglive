<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.TranscriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />

            <StackPanel Spacing="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind local:TranscriptPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                <TextBlock x:Uid="TranscriptPage_Empty"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                <Button x:Uid="TranscriptPage_EmptyCta"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="EmptyCta_Click"
                        AutomationProperties.AutomationId="BtnTranscriptEmptyRecord" />
            </StackPanel>

            <ScrollViewer Visibility="{x:Bind local:TranscriptPage.BoolToVisibility(ViewModel.HasContent), Mode=OneWay}"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{x:Bind ViewModel.Transcript, Mode=OneWay}" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="TxtTranscriptContent" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
