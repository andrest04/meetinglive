<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MeetingLive_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,24,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Uid="SessionPage_Back"
                    Click="Back_Click"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnSessionBack">
                <SymbolIcon Symbol="Back" />
            </Button>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind local:SessionPage.BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="720" />
                <Button x:Uid="SessionPage_Rename"
                        Click="Rename_Click"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnSessionRename">
                    <SymbolIcon Symbol="Edit" />
                </Button>
            </StackPanel>
        </Grid>

        <SelectorBar x:Name="SessionTabs"
                     Grid.Row="1"
                     Margin="24,0"
                     SelectionChanged="SessionTabs_SelectionChanged"
                     Visibility="{x:Bind local:SessionPage.BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}"
                     AutomationProperties.AutomationId="SelectorSessionTabs">
            <SelectorBarItem x:Name="TabTranscriptItem"
                             x:Uid="SessionPage_TabTranscript"
                             Tag="Transcript"
                             AutomationProperties.AutomationId="SelectorSessionTranscript" />
            <SelectorBarItem x:Name="TabSummaryItem"
                             x:Uid="SessionPage_TabSummary"
                             Tag="Summary"
                             AutomationProperties.AutomationId="SelectorSessionSummary" />
            <SelectorBarItem x:Name="TabNotesItem"
                             x:Uid="SessionPage_TabNotes"
                             Tag="Notes"
                             AutomationProperties.AutomationId="SelectorSessionNotes" />
        </SelectorBar>

        <Frame x:Name="SessionFrame"
               Grid.Row="2"
               IsNavigationStackEnabled="False"
               Visibility="{x:Bind local:SessionPage.BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}" />

        <ProgressRing Grid.Row="2"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />

        <StackPanel Grid.Row="2" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind local:SessionPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
            <TextBlock x:Uid="SessionPage_Empty"
                       Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" />
            <Button x:Uid="SessionPage_EmptyCta"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="EmptyCta_Click"
                    AutomationProperties.AutomationId="BtnSessionEmptyRecord" />
        </StackPanel>
    </Grid>
</Page>
