<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.SummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Summary" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Opacity="0.8" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasSummary), Mode=OneWay}">
                <Button Content="Copy" Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                        AutomationProperties.AutomationId="BtnCopySummary" />
                <Button Content="Open file location" Command="{x:Bind ViewModel.OpenFileLocationCommand}"
                        AutomationProperties.AutomationId="BtnOpenSummaryLocation" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                    Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.CanGenerateSummary), Mode=OneWay}">
            <Button Content="Generate summary" Command="{x:Bind ViewModel.GenerateSummaryCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="BtnGenerateSummary" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="3">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />

            <TextBlock Text="There's no summary yet. Record a meeting or generate one from its transcript."
                       Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}"
                       Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />

            <ScrollViewer Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasSummary), Mode=OneWay}"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               AutomationProperties.AutomationId="TxtSummaryContent" />

                    <StackPanel Spacing="8"
                                Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasActionItems), Mode=OneWay}">
                        <TextBlock Text="Action items" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ActionItems}"
                                      AutomationProperties.AutomationId="ListActionItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActionItemViewModel">
                                    <CheckBox Content="{x:Bind Text}" IsChecked="{x:Bind IsDone, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
