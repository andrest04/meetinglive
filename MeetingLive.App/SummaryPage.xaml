<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.SummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    xmlns:md="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="NotesModeBar"
                     SelectionChanged="NotesMode_SelectionChanged"
                     Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}"
                     AutomationProperties.AutomationId="SelectorSummaryNotesMode">
            <SelectorBarItem x:Uid="NotesMode_MyNotes"
                             Tag="notes"
                             AutomationProperties.AutomationId="SelectorSummaryMyNotes" />
            <SelectorBarItem x:Uid="NotesMode_Enhanced"
                             Tag="enhanced"
                             IsSelected="True"
                             AutomationProperties.AutomationId="SelectorSummaryEnhanced" />
        </SelectorBar>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowSummaryHeaderActions), Mode=OneWay}">
                <Button x:Uid="SummaryPage_Copy" Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                        AutomationProperties.AutomationId="BtnCopySummary" />
                <Button x:Uid="SummaryPage_OpenLocation" Command="{x:Bind ViewModel.OpenFileLocationCommand}"
                        AutomationProperties.AutomationId="BtnOpenSummaryLocation" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="2"
                 x:Uid="SummaryPage_CopyConfirmation"
                 Severity="Success"
                 IsOpen="{x:Bind ViewModel.IsCopyConfirmationOpen, Mode=TwoWay}"
                 AutomationProperties.AutomationId="InfoCopySummary" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12"
                    Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowSummaryActionBar), Mode=OneWay}">
            <Button Command="{x:Bind ViewModel.GenerateSummaryCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.CanGenerateSummary), Mode=OneWay}"
                    AutomationProperties.AutomationId="BtnGenerateSummary">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEB78;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="16" />
                    <TextBlock x:Uid="SummaryPage_Generate" />
                </StackPanel>
            </Button>
            <Button x:Uid="SummaryPage_Regenerate"
                    Command="{x:Bind ViewModel.RegenerateSummaryCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.CanRegenerateSummary), Mode=OneWay}"
                    AutomationProperties.AutomationId="BtnRegenerateSummary" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="8"
                    Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowNoteTemplate), Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbNoteTemplate"
                          x:Uid="SummaryPage_NoteTemplate"
                          ItemsSource="{x:Bind ViewModel.NoteTemplates, Mode=OneWay}"
                          SelectionChanged="NoteTemplate_SelectionChanged"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.AutomationId="CmbSummaryNoteTemplate">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteTemplateOption">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        x:Uid="SummaryPage_SaveCustomTemplate"
                        Click="SaveCustomTemplate_Click"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="BtnSaveSummaryCustomTemplate" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowDraftActions), Mode=OneWay}">
                <Button x:Uid="SummaryPage_ListActions"
                        Command="{x:Bind ViewModel.CopyActionItemsCommand}"
                        AutomationProperties.AutomationId="BtnListActions" />
                <Button x:Uid="SummaryPage_FollowUp"
                        Command="{x:Bind ViewModel.WriteFollowUpCommand}"
                        AutomationProperties.AutomationId="BtnWriteFollowUp" />
                <Button x:Uid="SummaryPage_ProjectPlan"
                        Command="{x:Bind ViewModel.DraftProjectPlanCommand}"
                        AutomationProperties.AutomationId="BtnDraftProjectPlan" />
            </StackPanel>
            <InfoBar x:Uid="SummaryPage_DraftError"
                     IsOpen="{x:Bind ViewModel.HasDraftMessage, Mode=OneWay}"
                     IsClosable="False"
                     Severity="{x:Bind local:SummaryPage.DraftSeverity(ViewModel.IsDraftError), Mode=OneWay}"
                     Message="{x:Bind ViewModel.DraftMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="InfoDraftStatus" />
        </StackPanel>

        <Grid Grid.Row="5">
            <TextBox x:Uid="SummaryPage_Notes"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="Notes_LostFocus"
                     Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.IsShowingNotes), Mode=OneWay}"
                     AutomationProperties.AutomationId="TxtMeetingNotes" />

            <Grid Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowEnhancedChrome), Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />

                <StackPanel Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                    <TextBlock x:Uid="SummaryPage_Empty"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />
                    <Button x:Uid="SummaryPage_EmptyCta"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="EmptyCta_Click"
                            AutomationProperties.AutomationId="BtnSummaryEmptyRecord" />
                </StackPanel>

                <ScrollViewer Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasSummary), Mode=OneWay}"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <md:MarkdownTextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                              TextWrapping="WrapWholeWords"
                                              Background="Transparent"
                                              AutomationProperties.AutomationId="TxtSummaryContent" />

                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasActionItems), Mode=OneWay}">
                            <TextBlock x:Uid="SummaryPage_ActionItems" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ActionItems, Mode=OneWay}"
                                          AutomationProperties.AutomationId="ListActionItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionItemViewModel">
                                        <CheckBox Content="{x:Bind Text, Mode=OneWay}" IsChecked="{x:Bind IsDone, Mode=TwoWay}" Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
