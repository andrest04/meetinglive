<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MeetingLive_App.SummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:MeetingLive_App"
    xmlns:vm="using:MeetingLive_App.ViewModels"
    xmlns:md="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d">

    <!-- One toolbar row (notes mode on the left, summary actions on the right) so the summary keeps almost all of the height.
         Only the content row scrolls; the toolbar stays put. Reading content is capped at a comfortable line length. -->
    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <SelectorBar x:Name="NotesModeBar"
                         SelectionChanged="NotesMode_SelectionChanged"
                         Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}"
                         AutomationProperties.AutomationId="SelectorSummaryNotesMode">
                <SelectorBarItem x:Uid="NotesMode_MyNotes"
                                 Tag="notes"
                                 AutomationProperties.AutomationId="SelectorSummaryMyNotes" />
                <SelectorBarItem x:Uid="NotesMode_Enhanced"
                                 Tag="enhanced"
                                 IsSelected="True"
                                 AutomationProperties.AutomationId="SelectorSummaryEnhanced" />
            </SelectorBar>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowSummaryActionBar), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               MaxWidth="240"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}" Width="20" Height="20" />
                    <Button Command="{x:Bind ViewModel.GenerateSummaryCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.CanGenerateSummary), Mode=OneWay}"
                            AutomationProperties.AutomationId="BtnGenerateSummary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB78;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="16" />
                            <TextBlock x:Uid="SummaryPage_Generate" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RegenerateSummaryCommand}"
                            Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.CanRegenerateSummary), Mode=OneWay}"
                            AutomationProperties.AutomationId="BtnRegenerateSummary">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="16" />
                            <TextBlock x:Uid="SummaryPage_RegenerateLabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ComboBox x:Name="CmbNoteTemplate"
                          x:Uid="SummaryPage_NoteTemplateCompact"
                          ItemsSource="{x:Bind ViewModel.NoteTemplates, Mode=OneWay}"
                          SelectionChanged="NoteTemplate_SelectionChanged"
                          Width="200"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowNoteTemplate), Mode=OneWay}"
                          AutomationProperties.AutomationId="CmbSummaryNoteTemplate">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteTemplateOption">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Uid="SummaryPage_More"
                        Width="40" Height="32" Padding="0"
                        Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowNoteTemplate), Mode=OneWay}"
                        AutomationProperties.AutomationId="BtnSummaryMore">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="SummaryPage_MoreSaveTemplate"
                                            Click="SaveCustomTemplate_Click"
                                            AutomationProperties.AutomationId="BtnSaveSummaryCustomTemplate">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="SummaryPage_MoreListActions"
                                            Command="{x:Bind ViewModel.CopyActionItemsCommand}"
                                            Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowDraftActions), Mode=OneWay}"
                                            AutomationProperties.AutomationId="BtnListActions">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4"
                    Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasRelatedMeetings), Mode=OneWay}">
            <TextBlock x:Uid="SummaryPage_RelatedMeetings" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView ItemsSource="{x:Bind ViewModel.RelatedMeetingItems, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="RelatedMeeting_ItemClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      AutomationProperties.AutomationId="ListRelatedMeetings">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RelatedMeetingItem">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{x:Bind Title, Mode=OneTime}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <TextBlock Text="{x:Bind DateLabel, Mode=OneTime}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <InfoBar Grid.Row="2"
                 x:Uid="SummaryPage_DraftError"
                 IsOpen="{x:Bind ViewModel.HasDraftMessage, Mode=OneWay}"
                 IsClosable="False"
                 Severity="{x:Bind local:SummaryPage.DraftSeverity(ViewModel.IsDraftError), Mode=OneWay}"
                 Message="{x:Bind ViewModel.DraftMessage, Mode=OneWay}"
                 AutomationProperties.AutomationId="InfoDraftStatus" />

        <Grid Grid.Row="3">
            <TextBox x:Uid="SummaryPage_Notes"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxWidth="880"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="Notes_LostFocus"
                     Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.IsShowingNotes), Mode=OneWay}"
                     AutomationProperties.AutomationId="TxtMeetingNotes" />

            <Grid Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.ShowEnhancedChrome), Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />

                <StackPanel Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
                    <TextBlock x:Uid="SummaryPage_Empty"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />
                    <Button x:Uid="SummaryPage_EmptyCta"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="EmptyCta_Click"
                            AutomationProperties.AutomationId="BtnSummaryEmptyRecord" />
                </StackPanel>

                <ScrollViewer Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasSummary), Mode=OneWay}"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" MaxWidth="880" Padding="0,0,16,0">
                        <md:MarkdownTextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                              TextWrapping="WrapWholeWords"
                                              Background="Transparent"
                                              AutomationProperties.AutomationId="TxtSummaryContent" />

                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind local:SummaryPage.BoolToVisibility(ViewModel.HasActionItems), Mode=OneWay}">
                            <TextBlock x:Uid="SummaryPage_ActionItems" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ActionItems, Mode=OneWay}"
                                          AutomationProperties.AutomationId="ListActionItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionItemViewModel">
                                        <CheckBox Content="{x:Bind Text, Mode=OneWay}" IsChecked="{x:Bind IsDone, Mode=TwoWay}" Margin="0,0,0,8" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
