<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MeetingLive_App.LiveCopilotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingLive_App"
    xmlns:md="using:CommunityToolkit.WinUI.UI.Controls">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Header: always visible, it is the whole collapsed pill. Only DragGrip is the title-bar
            region, so everything else in the header stays clickable.
        -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnSpacing="4" Padding="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="DragGrip"
                    Grid.Column="0"
                    Width="32"
                    Background="Transparent"
                    AutomationProperties.AutomationId="LiveCopilotDragGrip">
                <FontIcon Glyph="&#xE784;"
                          FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          AutomationProperties.AccessibilityView="Raw" />
            </Border>

            <Button x:Name="BtnBody"
                    Grid.Column="1"
                    Style="{StaticResource SubtleButtonStyle}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="Body_Click"
                    AutomationProperties.AutomationId="BtnLiveCopilotBody">
                <Grid>
                    <StackPanel x:Name="NormalStatus" Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10"
                                 Height="10"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                 Visibility="{x:Bind local:LiveCopilotWindow.InvertBoolToVisibility(ViewModel.IsPaused), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE769;"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.IsPaused), Mode=OneWay}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{x:Bind local:LiveCopilotWindow.StatusLabel(ViewModel.IsPaused), Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="TxtLiveCopilotElapsed" />
                        <Border x:Uid="LiveCopilot_ArmedBadge"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.HasArmedQuestion), Mode=OneWay}"
                                AutomationProperties.AutomationId="BadgeLiveCopilotArmed">
                            <TextBlock Text="?"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtStartedHint"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed"
                               AutomationProperties.AccessibilityView="Raw"
                               AutomationProperties.AutomationId="TxtLiveCopilotStarted" />
                </Grid>
            </Button>

            <Button x:Name="BtnOpenApp"
                    x:Uid="LiveCopilot_OpenApp"
                    Grid.Column="2"
                    Style="{StaticResource SubtleButtonStyle}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="OpenApp_Click"
                    AutomationProperties.AutomationId="BtnLiveCopilotOpenApp">
                <FontIcon Glyph="&#xE8A7;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
            </Button>

            <Button x:Name="BtnExpand"
                    x:Uid="LiveCopilot_Expand"
                    Grid.Column="3"
                    Style="{StaticResource SubtleButtonStyle}"
                    VerticalAlignment="Center"
                    Click="Expand_Click"
                    AutomationProperties.AutomationId="BtnLiveCopilotExpand">
                <FontIcon Glyph="&#xE70E;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
            </Button>

            <Button x:Name="BtnCollapse"
                    x:Uid="LiveCopilot_Collapse"
                    Grid.Column="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="Collapse_Click"
                    AutomationProperties.AutomationId="BtnLiveCopilotCollapse">
                <FontIcon Glyph="&#xE70D;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
            </Button>
        </Grid>

        <!-- Mini panel: only shown while expanded. -->
        <Grid x:Name="PanelGrid"
              Grid.Row="1"
              Padding="12,0,12,12"
              RowSpacing="8"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Detected-question card. -->
            <StackPanel Grid.Row="0"
                        Spacing="8"
                        Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.HasArmedQuestion), Mode=OneWay}">
                <InfoBar x:Uid="RecordPage_LiveQuestionNotice"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.ArmedQuestion, Mode=OneWay}"
                         AutomationProperties.AutomationId="InfoLiveCopilotQuestion" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="BtnLiveAnswer"
                            x:Uid="RecordPage_LiveAnswer"
                            Command="{x:Bind ViewModel.ConfirmLiveAnswerCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:LiveCopilotWindow.AnswerTooltip()}"
                            AutomationProperties.AutomationId="BtnLiveCopilotAnswer">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator x:Name="LiveAnswerAccelerator"
                                                 Modifiers="Control"
                                                 Key="Enter"
                                                 Invoked="LiveAnswer_AcceleratorInvoked" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Uid="RecordPage_LiveAnswerDismiss"
                            Command="{x:Bind ViewModel.DismissArmedQuestionCommand}"
                            AutomationProperties.AutomationId="BtnLiveCopilotDismiss" />
                </StackPanel>
            </StackPanel>

            <!-- Answer area. -->
            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12">
                    <StackPanel Spacing="8">
                        <InfoBar x:Uid="RecordPage_LiveAnswerError"
                                 IsOpen="{x:Bind ViewModel.HasLiveAnswerError, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Error"
                                 Message="{x:Bind ViewModel.LiveAnswerError, Mode=OneWay}"
                                 AutomationProperties.AutomationId="InfoLiveCopilotError" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Uid="RecordPage_LiveAnswerProgress"
                                          Width="20"
                                          Height="20"
                                          IsActive="{x:Bind ViewModel.IsAnswering, Mode=OneWay}"
                                          Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.IsAnswering), Mode=OneWay}"
                                          AutomationProperties.AutomationId="ProgressLiveCopilot" />
                            <TextBlock x:Uid="LiveCopilot_WebBadge"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.LiveAnswerUsedWeb), Mode=OneWay}"
                                       AutomationProperties.AutomationId="BadgeLiveCopilotWeb" />
                        </StackPanel>
                        <md:MarkdownTextBlock Text="{x:Bind ViewModel.LiveAnswerText, Mode=OneWay}"
                                              TextWrapping="WrapWholeWords"
                                              Background="Transparent"
                                              LinkClicked="Markdown_LinkClicked"
                                              Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.HasLiveAnswer), Mode=OneWay}"
                                              AutomationProperties.AutomationId="MdLiveCopilotAnswer" />
                        <TextBlock x:Uid="LiveCopilot_Empty"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind local:LiveCopilotWindow.EmptyHintVisibility(ViewModel.HasLiveAnswer, ViewModel.IsAnswering, ViewModel.HasLiveAnswerError), Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preset chips. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="LiveCopilot_ChipMissed"
                        Command="{x:Bind ViewModel.AskPresetCommand}"
                        CommandParameter="{x:Bind local:LiveCopilotWindow.PromptMissed()}"
                        AutomationProperties.AutomationId="BtnLiveCopilotChipMissed" />
                <Button x:Uid="LiveCopilot_ChipExplain"
                        Command="{x:Bind ViewModel.AskPresetCommand}"
                        CommandParameter="{x:Bind local:LiveCopilotWindow.PromptExplain()}"
                        AutomationProperties.AutomationId="BtnLiveCopilotChipExplain" />
            </StackPanel>

            <!-- Typed ask. -->
            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtLiveAsk"
                         AcceptsReturn="False"
                         PlaceholderText="{x:Bind local:LiveCopilotWindow.AskPlaceholder()}"
                         AutomationProperties.Name="{x:Bind local:LiveCopilotWindow.AskName()}"
                         Text="{x:Bind ViewModel.LiveAskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="TxtLiveCopilotAsk">
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator x:Name="LiveAskAccelerator"
                                             Modifiers="Control"
                                             Key="Enter"
                                             Invoked="LiveAsk_AcceleratorInvoked" />
                    </TextBox.KeyboardAccelerators>
                </TextBox>
                <ToggleButton Grid.Column="1"
                              x:Uid="LiveCopilot_WebToggle"
                              IsChecked="{x:Bind ViewModel.ForceWebSearch, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanUseWebSearch, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind local:LiveCopilotWindow.WebTooltip(ViewModel.CanUseWebSearch), Mode=OneWay}"
                              AutomationProperties.AutomationId="ToggleLiveCopilotWeb">
                    <FontIcon Glyph="&#xE774;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                </ToggleButton>
                <Button Grid.Column="2"
                        x:Uid="LiveCopilot_Send"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SubmitTypedAskCommand}"
                        AutomationProperties.AutomationId="BtnLiveCopilotSend">
                    <FontIcon Glyph="&#xE724;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
