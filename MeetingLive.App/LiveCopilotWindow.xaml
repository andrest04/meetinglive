<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MeetingLive_App.LiveCopilotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetingLive_App"
    xmlns:controls="using:MeetingLive_App.Controls"
    xmlns:md="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid x:Name="RootGrid"
          RequestedTheme="Dark"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <Color x:Key="LiveCopilotStopColor">#E5484D</Color>
                        <Color x:Key="LiveCopilotOnStopColor">#FFFFFF</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <Color x:Key="LiveCopilotStopColor">#C42B1C</Color>
                        <Color x:Key="LiveCopilotOnStopColor">#FFFFFF</Color>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="LiveCopilotStopColor" ResourceKey="SystemColorHighlightColor" />
                        <StaticResource x:Key="LiveCopilotOnStopColor" ResourceKey="SystemColorHighlightTextColor" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <!--
            Mini panel: only shown while expanded. Its position and size are set from code so it always
            grows from the capsule toward the screen center.
        -->
        <Grid x:Name="PanelGrid"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Padding="12"
              RowSpacing="8"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelTranslate" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Panel header: title and a way back to the full app. -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind local:LiveCopilotWindow.PanelTitle()}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="BtnOpenApp"
                        x:Uid="LiveCopilot_OpenApp"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        VerticalAlignment="Center"
                        Click="OpenApp_Click"
                        AutomationProperties.AutomationId="BtnLiveCopilotOpenApp">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </Grid>

            <!-- Detected-question card. -->
            <StackPanel Grid.Row="1"
                        Spacing="8"
                        Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.HasArmedQuestion), Mode=OneWay}">
                <InfoBar x:Uid="RecordPage_LiveQuestionNotice"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.ArmedQuestion, Mode=OneWay}"
                         AutomationProperties.AutomationId="InfoLiveCopilotQuestion" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="BtnLiveAnswer"
                            x:Uid="RecordPage_LiveAnswer"
                            Command="{x:Bind ViewModel.ConfirmLiveAnswerCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind local:LiveCopilotWindow.AnswerTooltip()}"
                            AutomationProperties.AutomationId="BtnLiveCopilotAnswer">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator x:Name="LiveAnswerAccelerator"
                                                 Modifiers="Control"
                                                 Key="Enter"
                                                 Invoked="LiveAnswer_AcceleratorInvoked" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Uid="RecordPage_LiveAnswerDismiss"
                            Command="{x:Bind ViewModel.DismissArmedQuestionCommand}"
                            AutomationProperties.AutomationId="BtnLiveCopilotDismiss" />
                </StackPanel>
            </StackPanel>

            <!-- Answer area. -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12">
                    <StackPanel Spacing="8">
                        <InfoBar x:Uid="RecordPage_LiveAnswerError"
                                 IsOpen="{x:Bind ViewModel.HasLiveAnswerError, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Error"
                                 Message="{x:Bind ViewModel.LiveAnswerError, Mode=OneWay}"
                                 AutomationProperties.AutomationId="InfoLiveCopilotError" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Uid="RecordPage_LiveAnswerProgress"
                                          Width="20"
                                          Height="20"
                                          IsActive="{x:Bind ViewModel.IsAnswering, Mode=OneWay}"
                                          Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.IsAnswering), Mode=OneWay}"
                                          AutomationProperties.AutomationId="ProgressLiveCopilot" />
                            <TextBlock x:Uid="LiveCopilot_WebBadge"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.LiveAnswerUsedWeb), Mode=OneWay}"
                                       AutomationProperties.AutomationId="BadgeLiveCopilotWeb" />
                        </StackPanel>
                        <md:MarkdownTextBlock Text="{x:Bind ViewModel.LiveAnswerText, Mode=OneWay}"
                                              TextWrapping="WrapWholeWords"
                                              Background="Transparent"
                                              LinkClicked="Markdown_LinkClicked"
                                              Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.HasLiveAnswer), Mode=OneWay}"
                                              AutomationProperties.AutomationId="MdLiveCopilotAnswer" />
                        <TextBlock x:Uid="LiveCopilot_Empty"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind local:LiveCopilotWindow.EmptyHintVisibility(ViewModel.HasLiveAnswer, ViewModel.IsAnswering, ViewModel.HasLiveAnswerError), Mode=OneWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preset chips. -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button x:Uid="LiveCopilot_ChipMissed"
                        Command="{x:Bind ViewModel.AskPresetCommand}"
                        CommandParameter="{x:Bind local:LiveCopilotWindow.PromptMissed()}"
                        AutomationProperties.AutomationId="BtnLiveCopilotChipMissed" />
                <Button x:Uid="LiveCopilot_ChipExplain"
                        Command="{x:Bind ViewModel.AskPresetCommand}"
                        CommandParameter="{x:Bind local:LiveCopilotWindow.PromptExplain()}"
                        AutomationProperties.AutomationId="BtnLiveCopilotChipExplain" />
            </StackPanel>

            <!-- Typed ask. -->
            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtLiveAsk"
                         AcceptsReturn="False"
                         PlaceholderText="{x:Bind local:LiveCopilotWindow.AskPlaceholder()}"
                         AutomationProperties.Name="{x:Bind local:LiveCopilotWindow.AskName()}"
                         Text="{x:Bind ViewModel.LiveAskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="TxtLiveCopilotAsk">
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator x:Name="LiveAskAccelerator"
                                             Modifiers="Control"
                                             Key="Enter"
                                             Invoked="LiveAsk_AcceleratorInvoked" />
                    </TextBox.KeyboardAccelerators>
                </TextBox>
                <ToggleButton Grid.Column="1"
                              x:Uid="LiveCopilot_WebToggle"
                              IsChecked="{x:Bind ViewModel.ForceWebSearch, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanUseWebSearch, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind local:LiveCopilotWindow.WebTooltip(ViewModel.CanUseWebSearch), Mode=OneWay}"
                              AutomationProperties.AutomationId="ToggleLiveCopilotWeb">
                    <FontIcon Glyph="&#xE774;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                </ToggleButton>
                <Button Grid.Column="2"
                        x:Uid="LiveCopilot_Send"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SubmitTypedAskCommand}"
                        AutomationProperties.AutomationId="BtnLiveCopilotSend">
                    <FontIcon Glyph="&#xE724;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </Grid>
        </Grid>

        <!--
            The capsule: app icon, audio bars, elapsed time, pause, stop and chat. Orientation (vertical on
            the left/right edges, horizontal on top/bottom), size and position are set from code. Pointer
            input that no button handles drags the capsule.
        -->
        <Grid x:Name="CapsuleHost"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Width="64"
              Height="240"
              PointerPressed="Capsule_PointerPressed"
              PointerMoved="Capsule_PointerMoved"
              PointerReleased="Capsule_PointerReleased"
              PointerCaptureLost="Capsule_PointerCaptureLost"
              AutomationProperties.AutomationId="LiveCopilotCapsule">
            <Border x:Name="CapsuleSurface"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="32" />

            <StackPanel x:Name="CapsuleStack"
                        Orientation="Vertical"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="CapsuleScale" />
                </StackPanel.RenderTransform>
                <Grid x:Name="IconTile"
                      Width="32"
                      Height="32"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border CornerRadius="{ThemeResource OverlayCornerRadius}"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <Image Width="22"
                               Height="22"
                               Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                               AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <Border x:Uid="LiveCopilot_ArmedBadge"
                            Width="16"
                            Height="16"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-4,-4,0"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind local:LiveCopilotWindow.BoolToVisibility(ViewModel.HasArmedQuestion), Mode=OneWay}"
                            AutomationProperties.AutomationId="BadgeLiveCopilotArmed">
                        <TextBlock Text="?"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </Grid>

                <controls:AudioBarsControl x:Name="AudioBars"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Level="{x:Bind ViewModel.MicLevel, Mode=OneWay}"
                                           IsPaused="{x:Bind ViewModel.IsPaused, Mode=OneWay}" />

                <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           MinWidth="40"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           ToolTipService.ToolTip="{x:Bind local:LiveCopilotWindow.StatusLabel(ViewModel.IsPaused), Mode=OneWay}"
                           AutomationProperties.AutomationId="TxtLiveCopilotElapsed" />

                <Button x:Name="BtnPause"
                        Width="36"
                        Height="36"
                        Padding="0"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.TogglePauseCommand}"
                        AutomationProperties.Name="{x:Bind local:LiveCopilotWindow.PauseName(ViewModel.IsPaused), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind local:LiveCopilotWindow.PauseName(ViewModel.IsPaused), Mode=OneWay}"
                        AutomationProperties.AutomationId="BtnLiveCopilotPause">
                    <FontIcon Glyph="{x:Bind local:LiveCopilotWindow.PauseGlyph(ViewModel.IsPaused), Mode=OneWay}"
                              FontSize="14"
                              AutomationProperties.AccessibilityView="Raw" />
                </Button>

                <Button x:Name="BtnStop"
                        x:Uid="LiveCopilot_Stop"
                        Width="36"
                        Height="36"
                        Padding="0"
                        CornerRadius="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                        AutomationProperties.AutomationId="BtnLiveCopilotStop">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource LiveCopilotStopColor}" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource LiveCopilotStopColor}" Opacity="0.85" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource LiveCopilotStopColor}" Opacity="0.7" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource LiveCopilotStopColor}" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource LiveCopilotStopColor}" Opacity="0.85" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource LiveCopilotStopColor}" Opacity="0.7" />
                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource LiveCopilotOnStopColor}" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource LiveCopilotOnStopColor}" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource LiveCopilotOnStopColor}" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE71A;" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
                </Button>

                <Button x:Name="BtnChat"
                        Width="32"
                        Height="32"
                        Padding="0"
                        CornerRadius="16"
                        Style="{StaticResource SubtleButtonStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="Chat_Click"
                        AutomationProperties.AutomationId="BtnLiveCopilotChat">
                    <FontIcon Glyph="&#xE8BD;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Soft outline of the whole window (capsule or expanded card); never takes input. -->
        <Border x:Name="WindowOutline"
                IsHitTestVisible="False"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="32" />
    </Grid>
</Window>
